{% assign ai_copy_response = 'snippets.chat.copy_response' | t: '复制回答' %}
{% assign ai_regenerate = 'snippets.chat.regenerate' | t: '重新生成' %}
<template data-ai-search-target="userMessageTemplate">
  <div class="ai-chat-user-round">
    <div class="ai-chat-user-content">
      <p class="ai-user-message"></p>
    </div>
    {% assign avatar = 'images/avatar1.svg' | asset_url %}
    <img src="{{ current_user.image | default: avatar }}" alt="" class="ai-chat-avatar ai-chat-avatar--user" />
  </div>
</template>

<template data-ai-search-target="assistantMessageTemplate">
  <div class="ai-chat-assistant-round">
    <div class="ai-chat-avatar ai-chat-avatar--bot">
      <i class="ri-robot-2-line text-base leading-none sm:text-lg" aria-hidden="true"></i>
    </div>
    <div class="ai-chat-assistant-body">
      <div class="ai-chat-bubble ai-chat-bubble--assistant" data-controller="markdown">
        <pre class="hidden" data-markdown-target="content"></pre>
        <div class="chat-message max-w-none break-words text-base-content" data-markdown-target="renderedContent"></div>
      </div>
      <div class="ai-message-actions hidden">
        <button
          type="button"
          class="btn btn-ghost btn-xs btn-square text-base-content/50 hover:text-base-content"
          data-action="click->ai-search#copyResponse"
          aria-label="{{ ai_copy_response | escape_once }}"
        >
          <i class="ri-file-copy-line text-sm leading-none" aria-hidden="true"></i>
        </button>
        <button
          type="button"
          class="btn btn-ghost btn-xs btn-square text-base-content/50 hover:text-base-content"
          data-action="click->ai-search#retryResponse"
          aria-label="{{ ai_regenerate | escape_once }}"
        >
          <i class="ri-refresh-line text-sm leading-none" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>
</template>

<button
  type="button"
  class="hidden btn btn-ghost btn-xs btn-square align-middle text-base-content/70"
  data-ai-search-target="retryButton"
  data-action="click->ai-search#retryFromButton"
  aria-label="{{ ai_regenerate | escape_once }}"
>
  <i class="ri-refresh-line leading-none" aria-hidden="true"></i>
</button>

<div data-ai-search-target="error" class="mx-auto hidden max-w-[50rem] px-4 text-sm text-error sm:px-6"></div>
