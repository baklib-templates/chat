      },
      {
        "id": "robot_name",
        "type": "text",
        "label": "t:schema.settings.brand.robot_name.label",
        "info": "t:schema.settings.brand.robot_name.info",
        "default": "AI 助手"
      },
      {
        "id": "ai_search_completed_text",
        "type": "textarea",
        "label": "t:schema.settings.brand.ai_search_completed_text.label",
        "info": "t:schema.settings.brand.ai_search_completed_text.info",
        "default": "t:schema.settings.brand.ai_search_completed_text.default"
      },
      {
        "id": "popular_searches",
        "type": "textarea",
        "label": "热搜问题",
        "info": "将展示在首页的热搜问题列表中，每行一个问题。"
      }
    ]
  },
