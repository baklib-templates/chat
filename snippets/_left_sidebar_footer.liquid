{% assign help_url = site.settings.help_url | presence %}
{% unless help_url %}
  {% assign help_page = site.pages['/help'] %}
  {% if help_page %}
    {% assign help_url = help_page.path %}
  {% else %}
    {% assign help_kb = site.pages['/'].children_in_list | first %}
    {% if help_kb %}
      {% assign help_url = help_kb.path %}
    {% endif %}
  {% endif %}
{% endunless %}

{%- assign nav_link = 'flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium text-base-content/65 transition-all hover:bg-base-content/5 hover:text-base-content' -%}
{%- assign nav_icon = 'flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-base-content/5 text-base' -%}

<div class="mt-auto flex flex-col gap-1 pt-4">
  {% render 'user_account', variant: 'sidebar' %}

  {% if help_url %}
    <div class="mt-2 border-t border-base-content/10 pt-3">
      <a href="{{ help_url }}" class="{{ nav_link }}" data-turbo-frame="_top">
        <i class="{{ nav_icon }} ri-question-line" aria-hidden="true"></i>
        <span>帮助</span>
      </a>
    </div>
  {% endif %}
</div>
