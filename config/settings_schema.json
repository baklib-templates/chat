        "height": 80,
        "label": "t:schema.settings.brand.logo_url.label",
        "info": "t:schema.settings.brand.logo_url.info"
      },
      {
        "id": "dark_logo_url",
        "type": "image_picker",
        "width": 300,
        "height": 80,
        "label": "t:schema.settings.brand.dark_logo_url.label",
        "info": "t:schema.settings.brand.dark_logo_url.info"
      },
      {
        "id": "brand_name",
        "label": "t:schema.settings.brand.brand_name.label",
        "type": "text",
        "default": "品牌名称"
      },
      {
        "id": "site_description",
        "label": "t:schema.settings.brand.site_description.label",
        "type": "text",
        "default": "支持智能问答、文档检索、标签筛选等功能，助您快速获取所需信息，为您提供 7×24 智能问答与帮助文档服务，提升工作效率与客户满意度。"
      },
      {
        "id": "company_name",
        "label": "t:schema.settings.brand.company_name.label",
        "type": "text",
        "default": "公司名称"
      },
      {
        "id": "welcome_title",
        "label": "t:schema.settings.brand.welcome_title.label",
        "type": "text",
        "default": "AI 知识问答助手"
      },
      {
        "id": "welcome_description",
        "label": "t:schema.settings.brand.welcome_description.label",
        "type": "text",
