{%# locals:(nav_tree:, depth: 0, class: '') %}
<ul>
  {% for tree in nav_tree %}
    {% if tree.children %}
      <li class='mt-1'>
        <details>
          <summary data-nav-tree-target="item" class='hover:bg-transparent hover:text-primary'><a href="{{ tree.path }}"  data-turbo-frame="page-content" @click="isDrawerOpen = false">{{ tree.link_text }}</a></summary>
          {% assign newDepth = depth | plus: 1 %}
          {% render 'sub_nav_tree', nav_tree: tree.children, depth: newDepth %}
        </details>
      </li>
    {% else %}
      <li class='mt-1'>
        <summary class='hover:bg-transparent hover:text-primary'>
          <a data-nav-tree-target="item" href="{{ tree.path }}"  data-turbo-frame="page-content" @click="isDrawerOpen = false">{{ tree.link_text }}</a>
        </summary>
      </li>
    {% endif %}
  {% endfor %}
</ul>
