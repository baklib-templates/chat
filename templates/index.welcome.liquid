{% assign popular_searches = site.settings.popular_searches %}
{% assign welcome_title = site.settings.welcome_title | default: "AI 知识问答助手" %}
{% assign welcome_description = site.settings.welcome_description | default: "请输入您想了解的问题，系统将基于文档内容和智能分析，快速为您找到最相关的答案。" %}

<div class="sm:flex min-h-screen">
    {% render 'sidebar' %}
    <!-- Start User chat -->
    <div class="overflow-hidden w-full bg-base-100">
        <div class="sm:flex">
            <div class="flex flex-col flex-1 min-h-screen">
                <!-- 欢迎语 -->
                <div class="h-[calc(100vh-60px)] flex items-center justify-center px-4 py-8 sm:py-16 text-center">
                    <div class="w-full max-w-3xl">
                        <!-- 顶部欢迎区域 -->
                        <div class="mb-8 text-center">
                            <h1 class="text-2xl sm:text-4xl md:text-5xl font-semibold mb-4 text-base-content">
                                {{ welcome_title }}
                            </h1>
                            <p class="mx-auto mt-4 max-w-2xl text-center text-base text-base-content/70 leading-relaxed">
                                {{ welcome_description }}
                            </p>
                            <!-- 热门问题 -->
                            <div class="mt-8 mx-auto max-w-3xl flex flex-wrap justify-center gap-2 sm:gap-3">
                                {% for question in popular_searches %}
                                    {% if question != blank %}
                                    <a href="/-/search?q={{ question | url_encode }}" class="text-xs sm:text-sm text-base-content/80 hover:text-primary rounded-full px-4 py-2 glass rounded-glass hover:shadow-glass transition-all duration-200 hover:scale-105 active:scale-95">
                                        {{ question }}
                                    </a>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>

                        <!-- 输入框 -->
                        {% form_tag 'search', class: 'mx-auto w-full max-w-3xl' %}
                            <div class="group flex flex-col px-4 sm:px-6 pt-5 pb-4 rounded-glass-lg glass shadow-glass focus-within:bg-primary-200">
                                <!-- 输入区 -->
                                <textarea rows="1"
                                    class="w-full resize-none bg-transparent border-none outline-none text-sm sm:text-base font-normal min-h-[44px] placeholder:text-base-content/60"
                                    placeholder="输入您的问题..." name="{{form.keywords_field_name}}" value="{{ search.keywords | escape_once }}" autocomplete="off"
                                    onkeydown="if(event.key==='Enter' && !event.shiftKey){event.preventDefault(); this.form.submit();}"
                                    ></textarea>
                                <!-- 底部按钮区 -->
                                <div class="flex items-center justify-between mt-3">
                                    <div class="text-xs text-base-content/50 hidden sm:block">
                                        <span>按 Enter 发送，Shift + Enter 换行</span>
                                    </div>
                                    <!-- 右侧按钮 -->
                                    <button type="submit"
                                        class="flex justify-center items-center w-10 h-10 sm:w-12 sm:h-12 rounded-full glass-strong bg-primary text-primary-content hover:scale-110 active:scale-95 transition-all duration-200 shadow-sm hover:shadow-md">
                                        <!-- 发送icon -->
                                        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" stroke-width="2.5"
                                            viewBox="0 0 24 24">
                                            <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round"
                                                stroke-linejoin="round" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                            <div class="mt-3 text-xs text-base-content/50 text-center">
                                <span>* AI 会根据当前知识库中的内容进行总结回答，而不会引用外部数据。</span>
                            </div>
                        {% endform_tag %}
                    </div>
                </div>

                {%# render 'footer', page: page %}
            </div>
        </div>
        <!-- End User chat -->
    </div>
    <!-- end  layout wrapper -->
</div>

{% schema %}
    {
        "name": "t:schema.templates.index.name",
        "description": "t:schema.templates.index.description",
        "thumb_url": "images/theme/index.webp",
        "preview_image_urls": [
            "images/theme/index.webp"
        ],
        "sub_page_templates": [
            "page"
        ]
    }
{% endschema %}