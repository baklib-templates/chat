{% for tag in site.tags %}
  {% assign tag = tag %}
  {% break %}
{% endfor %}
{% assign tag_heading = 'templates.tag.heading' | t: '标签分类' %}
{% assign tag_empty_title = 'templates.tag.empty_tags_title' | t: '暂无标签' %}
{% assign tag_empty_description = 'templates.tag.empty_tags_description' | t: '请在后台添加标签' %}
{% assign tag_empty_content = 'templates.tag.empty_content' | t: '暂无内容' %}

<div class="flex min-h-0 min-w-0 flex-1 overflow-hidden">
  <!-- start chat-leftsidebar -->
  <div class=" min-w-[380px] max-w-[400px] bg-base-200 border-r border-base-300 px-8 py-8 h-screen overflow-auto hidden sm:block">
    <!-- 标题 -->
    <div class="mb-4 text-xl font-bold">{{ tag_heading }}</div>

    <!-- 标签列表 -->
    <ul class="space-y-2" x-data="">
      {% for site_tag in site.tags %}
      <li>
        <a href="{{ site_tag.path }}" class="flex items-center p-2 rounded-xl transition hover:bg-accent"
          :class="'{{ tag.name }}' === '{{ site_tag.name }}' ? 'bg-accent' : ''" href="/?tag_name={{ tag.name }}" >
          <span class="flex justify-center items-center mr-3 w-4 h-4 text-lg font-bold rounded-full"
            style="background-color: {{ site_tag.color }}"></span>
          <span class="text-sm font-medium text-base-content/90">{{ site_tag.name }}</span>
          <span class="ml-auto font-semibold text-pink-500 bg-pink-100 border-0 badge badge-lg"> {{
            site_tag.pages
            | size }} </span>
        </a>
      </li>
      {% else %}
        {% render 'empty', title: tag_empty_title, description: tag_empty_description %}
      {% endfor %}

    </ul>
  </div>
  <!-- end chat-leftsidebar -->

  <!-- Start User chat -->
  <turbo-frame id="page-content" class="overflow-hidden w-full bg-base-100" x-data="{ isDrawerOpen: false }">
    <input id="my-drawer" type="checkbox" class="drawer-toggle"  x-model="isDrawerOpen" />
    <!-- 抽屉侧边栏 -->
    <div class="z-20 drawer-side">
        <label for="my-drawer" class="drawer-overlay"></label>
        <div class="overflow-auto p-4 w-80 h-screen bg-base-200 text-base-content">
        <!-- 点击任何链接都会关闭抽屉（因为 checkbox 被取消选中） -->
          <!-- 标签列表 -->
          <ul class="space-y-2" x-data="">
            {% for site_tag in site.tags %}
            <li>
              <a href="{{ site_tag.path }}" class="flex items-center p-2 rounded-xl transition hover:bg-accent"
                :class="'{{ tag.name }}' === '{{ site_tag.name }}' ? 'bg-accent' : ''" href="/?tag_name={{ tag.name }}" @click="isDrawerOpen = false">
                <span class="flex justify-center items-center mr-3 w-4 h-4 text-lg font-bold rounded-full"
                  style="background-color: {{ site_tag.color }}"></span>
                <span class="text-sm font-medium text-base-content/90">{{ site_tag.name }}</span>
                <span class="ml-auto font-semibold text-pink-500 bg-pink-100 border-0 badge badge-lg"> {{
                  site_tag.pages
                  | size }} </span>
              </a>
            </li>
            {% else %}
              {% render 'empty', title: tag_empty_title, description: tag_empty_description %}
            {% endfor %}
          </ul>
        </div>
    </div>
    <div class="sm:flex">
      <div class="flex flex-col flex-1 min-h-screen">
        <!-- 欢迎语 -->
        <div class="flex justify-between items-center px-8 h-20 border-b bg-base-100 border-base-content/15">
          <label for="my-drawer" class="flex-none btn btn-square btn-ghost sm:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-5 h-5 stroke-current">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </label>
          <!-- 左侧绿色小圆点 -->
          <span> {{ tag.name }} </span>
        </div>
        {% paginate_tag tag.pages, as: 'items', per: 12 %}
        <div class="h-[calc(100vh-184px)] overflow-y-auto p-4 relative first-letter:text">
          <div class="p-6">
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              {% for page in items %}
                {% render 'tag/card', page: page %}
              {% else %}
              {% render 'empty', title: tag_empty_content, icon: 'document' %}
              {% endfor %}
            </div>
          </div>
          <div class="my-4 text-center md:col-span-12 sm:hidden">
            {% render 'paginate', paginate: paginate %}
          </div>
        </div>
        <div class="hidden grid-cols-1 p-1 mt-6 border-t border-base-content/15 md:grid-cols-12 sm:grid">
          <div class="my-4 text-center md:col-span-12">
            {% render 'paginate', paginate: paginate %}
          </div>
        </div>
        {% endpaginate_tag %}
      </div>
      <!-- End User chat -->
    </div>
    <!-- end  layout wrapper -->
  </turbo-frame>
</div>

