{% assign chat_messages = site.chat_messages | order_by: 'created_at' | limit: 10 %}
<div class="sm:flex">
    {% render 'sidebar' %}

    {% assign extends_size = search.extends | size %}
    {% assign items_size = items | size %}
    {% assign total_size = extends_size | plus: items_size %}
    {% assign top_5_paths = items | map: 'path' | limit: 5 | join: ',' %}
    <!-- start chat-leftsidebar -->
    <div class=" min-w-[380px] max-w-[400px] bg-gray-50 border-r border-gray-100 px-8 py-8 h-screen overflow-y-auto">
        <h2 class="mb-4 text-xl font-bold">AI 智能搜索</h2>

        <turbo-frame id="frame--search-results" class="overflow-hidden flex-1">
            <!-- 搜索框 -->
            <label class="flex gap-2 items-center mb-4 w-full input input-bordered">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 10-14 0 7 7 0 0014 0z" />
                </svg>

                {% form_tag 'search', class: 'w-full' %}
                    <input type="text" class="grow" placeholder="输入关键词过滤" name="{{form.keywords_field_name}}" value="{{ search.keywords | escape_once }}"
                    placeholder="{{ "layout.theme.search_input_placeholder" | t }}"
                    autocomplete="off"/>
                {% endform_tag %}
            </label>
            {% paginate_tag search.pages, as: 'items', per: 10 %}
            <!-- 搜索结果 -->
            <div>
                <h3 class="mb-4 text-sm text-gray-500">搜索结果</h3>

                <!-- 单条搜索结果 -->
                <div class="space-y-5">

                    {% if search.page_number == 1 and extends_size > 0 %}
                        {% for link in search.extends %}
                        <div class="flex gap-3 items-start">
                            <div class="flex-none text-lg font-semibold text-primary">{{ forloop.index }}</div>
                            <div class="flex-grow">
                                <a class="text-base font-medium search-highlight-block" href="{{ page.url }}" data-turbo-frame="_top">
                                    {{ link.link_text }}
                                </a>

                                <a class="text-sm leading-6 text-gray-500 break-all line-clamp-2"
                                    href="{{ page.url }}" data-turbo-frame="_top" x-cloak>{{ {{ link.url
                                    }}
                                </a>
                            </div>
                        </div>
                        {% endfor %}
                    {% endif %}

                    {% for page in items %}
                        <div class="flex gap-3 items-start">
                            <div class="flex-none text-lg font-semibold text-primary">{{ forloop.index }}</div>
                            <div class="flex-grow">
                                <a class="text-base font-medium search-highlight-block" href="{{ page.url }}" data-turbo-frame="_top">
                                    {{ page.highlighted_search_title }}
                                </a>
                                {% unless page.highlighted_search_content == empty %}
                                <a class="text-sm leading-6 text-gray-500 break-all line-clamp-2 search-highlight-block"
                                    href="{{ page.url }}" data-turbo-frame="_top" x-cloak>{{ page.highlighted_search_content
                                    }}
                                </a>
                                {% endunless %}
                            </div>
                        </div>
                        {% endfor %}
                </div>

                <div class="flex justify-center px-3 my-8">
                    {% render 'paginate', paginate: paginate %}
                </div>
            </div>
            {% endpaginate_tag %}
        </turbo-frame>
    </div>
    <!-- end chat-leftsidebar -->

    <!-- Start User chat -->
    <div class="overflow-hidden w-full bg-white" id="js--ai-search-completion-container" data-turbo-permanent>
        <div class="sm:flex" id="js--ai-search-completion" data-controller="ai-search-completion"
            data-ai-search-completion-hidden-class="hidden opacity-0"
            data-ai-search-completion-messages-value='{"started":"{{ ai_search_started_text }}","reading":"{{ ai_search_reading_text }}","thinking":"{{ ai_search_thinking_text }}"}'
            data-ai-search-completion-url-value="/-/ai-search-completion"
            data-ai-search-completion-auto-submit-value="true">
            <div class="flex flex-col flex-1 min-h-screen">
                <!-- 欢迎语 -->
                <div class="flex justify-between items-center px-8 h-20 bg-white border-b border-gray-200">
                    <!-- 左侧绿色小圆点 -->
                    <span>会话中 <i class="ri-record-circle-fill font-size-10 text-success d-inline-block ms-1"></i> </span>
                    <!-- 右侧更多操作 -->
                    <button class="flex items-center space-x-1 text-gray-400 hover:text-gray-600">
                        <i class="ri-more-fill"></i>
                    </button>
                </div>


                <div class="h-[calc(100vh-184px)] overflow-y-auto p-4 relative ">
                    {% comment %} AI 搜索结果区域 {% endcomment %}
                    <div class="flex-grow-0 order-1 w-full md:order-2 md:w-full">
                        <div class="py-4 space-y-2 rounded bg-primary-50 chat-container">
                            <div
                                class="overflow-y-auto gap-2 ai-response prose scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-gray-100">
                                {% for message in chat_messages %}
                                    {% if message.role == 'user'  %}
                                        <div class="flex gap-3 justify-end items-start">
                                            <div class="text-right">
                                                <div
                                                    class="p-3 max-w-xs break-words rounded-xl rounded-br-none bg-base-200 text-base-content ai-user-message">
                                                    {{ message.content }}
                                                </div>
                                                <div class="mt-1 text-xs text-gray-400">10:02</div>
                                                <div class="text-sm font-medium text-gray-700"> {{ current_user.name }} </div>
                                            </div>
                                            <img src="https://i.pravatar.cc/40?img=32" class="w-10 h-10 rounded-full" />
                                        </div>
                                    {% else %}
                                        <div class="flex gap-3 items-start">
                                            <div class="avatar avatar-online avatar-placeholder">
                                                <div class="w-10 rounded-full bg-neutral text-neutral-content">
                                                <span class="text-xl">AI</span>
                                                </div>
                                            </div>
                                            <div class="flex-1 min-w-0" data-controller="markdown-renderer">
                                                <div
                                                    class="p-3 text-white break-words bg-violet-500 rounded-xl rounded-bl-none w-fit max-w-3/4 ai-assistant-message" data-markdown-renderer-target="content"
                                                    >{{ message.content }}
                                                </div>

                                                <div class="mt-1 text-sm font-medium text-gray-700">
                                                gpt-4o
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>

                            <div data-ai-search-completion-target="messages"
                                class="overflow-y-auto gap-2 ai-response prose scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-gray-100">
                                <!-- 多轮消息将在这里显示 -->
                            </div>
                            <template data-ai-search-completion-target="userMessageTemplate">
                                <div class="flex gap-3 justify-end items-start">
                                    <div class="text-right">
                                        <div
                                            class="p-3 max-w-xs break-words rounded-xl rounded-br-none bg-base-200 text-base-content ai-user-message">
                                        </div>
                                        <div class="mt-1 text-xs text-gray-400">10:02</div>
                                        <div class="text-sm font-medium text-gray-700"> {{ current_user.name }} </div>
                                    </div>
                                    <img src="https://i.pravatar.cc/40?img=32" class="w-10 h-10 rounded-full" />
                                </div>
                            </template>
                            <template data-ai-search-completion-target="assistantMessageTemplate">
                                <div class="flex gap-3 items-start">
                                    <div class="avatar avatar-online avatar-placeholder">
                                        <div class="w-10 rounded-full bg-neutral text-neutral-content">
                                        <span class="text-xl">AI</span>
                                        </div>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div
                                            class="p-3 text-white break-words bg-violet-500 rounded-xl rounded-bl-none w-fit max-w-3/4 ai-assistant-message">
                                        </div>

                                        <div class="mt-1 text-sm font-medium text-gray-700">
                                        gpt-4o
                                        </div>
                                    </div>
                                </div>
                            </template>
                            <div data-ai-search-completion-target="error"
                                class="hidden text-red-500 opacity-100 transition-opacity duration-300"></div>
                        </div>
                        <script>
                            (function () {
                                setTimeout(function () {
                                    const aiSearchCompletionContainer = document.getElementById('js--ai-search-completion-container');
                                    const aiSearchCompletion = document.getElementById('js--ai-search-completion');
                                    aiSearchCompletion.dataset.aiSearchCompletionMessageValue = "{{ search.keywords | escape_once }}";
                                }, 1000);
                            })()
                        </script>
                    </div>
                </div>

                <div class="p-1 border-t border-gray-200">
                    <div class="flex items-center p-4 bg-white rounded-b-2xl">
                        <!-- 输入框 -->
                        <input type="text" placeholder="请输入你的问题…" id="js--ai-chat-input"
                            data-ai-search-completion-target="input" autocomplete="off"
                            class="flex-1 mr-4 text-gray-500 bg-gray-200 rounded-md border-0 input input-bordered focus:outline-none focus:ring-0 placeholder:text-gray-400" />


                        <button id="js--ai-chat-send" data-ai-search-completion-target="send" type="button"
                            class="text-base btn btn-primary">
                            <i class="ri-send-plane-2-fill"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="hidden user-profile-sidebar">
                <div class="px-3 pt-3 px-lg-4 pt-lg-4">
                    <div class="user-chat-nav text-end">
                        <button type="button" class="btn nav-btn" id="user-profile-hide">
                            <i class="ri-close-line"></i>
                        </button>
                    </div>
                </div>

                <div class="p-4 text-center border-bottom">
                    <div class="mb-4">
                        <img src="assets/images/users/avatar-4.jpg" class="rounded-circle avatar-lg img-thumbnail"
                            alt="">
                    </div>

                    <h5 class="mb-1 font-size-16 text-truncate">Doris Brown</h5>
                    <p class="mb-1 text-muted text-truncate"><i
                            class="ri-record-circle-fill font-size-10 text-success me-1 ms-0"></i> Active</p>
                </div>
                <!-- End profile user -->

                <!-- Start user-profile-desc -->

                <!-- end user-profile-desc -->
            </div>
        </div>
        <!-- End User chat -->
    </div>
    <!-- end  layout wrapper -->
</div>
