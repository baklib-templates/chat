{% assign logo_url = site.settings.logo_url | presence %}
{% assign avatar = 'images/avatar.png' | asset_url %}
<!-- Start left sidebar-menu -->
<div class="flex z-10 flex-shrink-0 min-h-screen shadow-md sm:flex-col bg-base-100 side-menu" >
  <!-- LOGO -->
  <div class="hidden justify-center items-center sm:flex">
    <a href="index.html">
      <span class="logo-sm">
        {% if logo_url %}
          <img
          src="{{ logo_url }}"
          alt="{{ site.name | escape_once }}"
          class="m-4 w-8" >
        {% else %}
          {% assign favicon_url = site.favicon_url | presence %}
          {% if favicon_url %}
            <img
            src="{{ favicon_url }}"
            alt="{{ site.name | escape_once }}"
            class="m-4 w-8" >
          {% endif %}
        {% endif %}
      </span>
    </a>
  </div>
  <!-- end navbar-brand-box -->

  <!-- Start side-menu nav -->
  <div class="flex justify-center my-auto sm:flex-col">
    <ul class="flex justify-center items-center sm:flex-col" data-controller="nav-tree" data-nav-tree-active-class="sidebar-menu-active">
      <li class="m-2" >
        <a class="flex justify-center items-center w-12 h-12 rounded-md hover:bg-base-300" href="/"
          role="tab" data-nav-tree-target="item">
          <i class="text-2xl text-base-content/50 ri-home-2-line"></i>
        </a>
      </li>
      <li class="m-2" title="AI 智能搜索" >
        <a class="flex justify-center items-center w-12 h-12 rounded-md hover:bg-base-300" href="/-/search"
          role="tab" data-nav-tree-target="item">
          <i class="text-2xl text-base-content/50 ri-message-3-line"></i>
        </a>
      </li>
      <li class="m-2" title="标签分类">
        <a class="flex justify-center items-center w-12 h-12 rounded-md hover:bg-base-300 {% if tag %}
          sidebar-active
        {% endif %}"
        href="/s/tags"
          role="tab" data-nav-tree-target="item">
          <i class="text-2xl text-base-content/50 ri-bookmark-line"></i>
        </a>
      </li>

      {% assign page = site.pages['/'].children |first %}
      <li class="m-2" title="目录" data-nav-tree-target="item">
        <a class="flex justify-center items-center w-12 h-12 rounded-m d hover:bg-base-300" href="{{ page.path }}"
          role="tab" data-nav-tree-target="item">
          <i class="text-2xl text-base-content/50 ri-list-ordered-2"></i>
        </a>
      </li>

      {% if current_user %}
        <li class="m-2 btn-group dropdown dropdown-top sm:hidden">
          <a class="flex justify-center items-center w-12 h-12 rounded-md hover:bg-base-300" href="#"
            role="button" tabindex="0">
            <img
              src="{{ current_user.image | default: avatar }}"
              alt="" class="w-9 h-9 rounded-full">
          </a>
          <ul tabindex="0" class="p-2 w-44 shadow-sm dropdown-content menu bg-base-100 rounded-box z-1">
            <a class="px-4 py-2 font-normal text-left rounded cursor-pointer text-base-content/80 hover:bg-base-300 focus:bg-base-300"  href="{{ current_user.profile_url }}">  {{ 'generic.profile' | t }} <i class="ri-profile-line float-end text-muted"></i></a>
            {% form_tag 'sign_out' %}
              <button class="px-4 py-2 w-full font-normal text-left rounded cursor-pointer text-base-content/80 hover:bg-base-300 focus:bg-base-300" href="auth-login.html">{{ 'buttons.logout' | t }}  <i
                class="ri-logout-circle-r-line float-end text-muted"></i></button>
            {% endform_tag %}
          </ul>
        </li>
      {% else %}
        <li class="m-2 sm:hidden" title="点击登录">
          <a class="flex relative justify-center items-center w-12 h-12 rounded-md hover:bg-base-300" >
            <i class="text-2xl text-base-content/50 ri-user-line"></i>
            {% form_tag 'sign_in_with_baklib' %}
              <button
                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"> </button>
            {% endform_tag %}
          </a>
        </li>
      {% endif %}
    </ul>
  </div>
  <!-- end side-menu nav -->

  <div class="hidden justify-center sm:flex">
    <ul class="nav side-menu-nav justify-content-center">
      <li class="m-2">
        <label class="items-center w-12 h-12 rounded-md hover:bg-base-300 swap swap-rotate">
          <!-- this hidden checkbox controls the state -->
          <input type="checkbox" class="theme-controller" value="dark" />

          <!-- sun icon -->
          <i class="text-2xl text-base-content/50 ri-sun-line theme-mode-icon swap-off"></i>

          <!-- moon icon -->
          <i class="text-2xl text-base-content/50 ri-moon-line theme-mode-icon swap-on"></i>
        </label>
      </li>


      {% if current_user %}
        <li class="m-2 btn-group dropdown dropdown-top">
          <a class="flex justify-center items-center w-12 h-12 rounded-md hover:bg-base-300" href="#"
            role="button" tabindex="0">
            <img
              src="{{ current_user.image | default: avatar }}"
              alt="" class="w-9 h-9 rounded-full">
          </a>
          <ul tabindex="0" class="p-2 w-44 shadow-sm dropdown-content menu bg-base-100 rounded-box z-1">
            <a class="px-4 py-2 font-normal text-left rounded cursor-pointer text-base-content/80 hover:bg-base-300 focus:bg-base-300"  href="{{ current_user.profile_url }}">  {{ 'generic.profile' | t }} <i class="ri-profile-line float-end text-muted"></i></a>
            {% form_tag 'sign_out' %}
              <button class="px-4 py-2 w-full font-normal text-left rounded cursor-pointer text-base-content/80 hover:bg-base-300 focus:bg-base-300" href="auth-login.html">{{ 'buttons.logout' | t }}  <i
                class="ri-logout-circle-r-line float-end text-muted"></i></button>
            {% endform_tag %}
          </ul>
        </li>
      {% else %}
        <li class="m-2" title="点击登录">
          <a class="flex relative justify-center items-center w-12 h-12 rounded-md hover:bg-base-300" >
            <i class="text-2xl text-base-content/50 ri-user-line"></i>
            {% form_tag 'sign_in_with_baklib' %}
              <button
                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"> </button>
            {% endform_tag %}
          </a>
        </li>
      {% endif %}
    </ul>
  </div>
  <!-- Side menu user -->
</div>
