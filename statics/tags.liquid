{% for tag in site.tags %}
  {% assign tag = tag %}
  {% break %}
{% endfor %}

<div class="sm:flex">
  {% render 'sidebar' %}

  <!-- start chat-leftsidebar -->
  <div class=" min-w-[380px] max-w-[400px] bg-gray-50 border-r border-gray-100 px-8 py-8 h-screen overflow-auto">
    <!-- 标题 -->
    <div class="mb-4 text-xl font-bold">标签分类</div>

    <!-- 标签列表 -->
    <ul class="space-y-2" x-data="">
      {% for site_tag in site.tags %}
      <li>
        <a href="{{ site_tag.path }}" class="flex items-center p-2 rounded-xl transition hover:bg-slate-200"
          :class="'{{ tag.name }}' === '{{ site_tag.name }}' ? 'bg-slate-200' : ''" href="/?tag_name={{ tag.name }}" >
          <span class="flex justify-center items-center mr-3 w-4 h-4 text-lg font-bold rounded-full"
            style="background-color: {{ site_tag.color }}"></span>
          <span class="text-sm font-medium text-gray-800">{{ site_tag.name }}</span>
          <span class="ml-auto font-semibold text-pink-500 bg-pink-100 border-0 badge badge-lg"> {{
            site_tag.pages
            | size }} </span>
        </a>
      </li>
      {% endfor %}

    </ul>
  </div>
  <!-- end chat-leftsidebar -->

  <!-- Start User chat -->
  <turbo-frame id="page-content" class="overflow-hidden w-full bg-white">
    <div class="sm:flex">
      <div class="flex flex-col flex-1 min-h-screen">
        <!-- 欢迎语 -->
        <div class="flex justify-between items-center px-8 h-20 bg-white border-b border-gray-200">
          <!-- 左侧绿色小圆点 -->
          <span> {{ tag.name }}
            <i class="ri-record-circle-fill font-size-10 text-success d-inline-block ms-1"></i>
          </span>
        </div>
        {% paginate_tag tag.pages, as: 'items', per: 12 %}
        <div class="h-[calc(100vh-184px)] overflow-y-auto p-4 relative first-letter:text">
          <div class="p-6">
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              {% for page in items %}
              <article
                class="flex flex-col h-full bg-white rounded-lg border border-gray-200 transition-all duration-200 hover:border-teal-600 hover:ring hover:ring-teal-600 hover:bg-teal-50 hover:-translate-y-1 aos-init"
                data-aos="fade-up">
                <!-- Image -->

                <a class="block overflow-hidden relative rounded-t-lg group" href="{{ page.path }}" data-turbo-frame="page-content">
                  <img
                    class="w-full rounded-t-lg aspect-[16/9] md:aspect-video object-cover group-hover:scale-105 transition duration-700 ease-out"
                    src="{{ page.settings.icon }}" alt="什么是轻Wiki？ - Baklib">

                  <div class="absolute bottom-6 start-6">
                    {% for tag in page.settings.tags %}
                    <span class="bg-primary text-white text-[12px] px-2.5 py-1 rounded-md h-4 mx-[2px]"
                      href="?tag={{ tag.name }}">{{ tag.name }}</span>
                    {% endfor %}
                  </div>
                </a>

                <!-- Content -->
                <div class="flex flex-col p-4 grow">
                  <h3 class="mb-3 text-xl font-black tracking-tight">
                    <a class="hover:underline hover:decoration-primary-200" href="{{ page.path }}" data-turbo-frame="page-content">{{
                      page.settings.title }}</a>
                  </h3>
                  <p class="text-slate-500 grow line-clamp-3">{{ page.settings.content | strip_html | truncate: 100 }}
                  </p>
                  <div class="flex justify-between items-center mt-4 text-xs">
                    <div class="flex items-center">
                      <img class="mr-3 rounded-full shrink-0" src="{{ page.author.avatar_url }}" width="32" height="32">
                      <span class="font-medium text-slate-800">{{ page.author.name }}</span>
                    </div>
                    <div class="flex items-center text-slate-500">
                      {{ page.created_at | date: '%Y-%m-%d' }}
                    </div>
                  </div>
                </div>
              </article>
              {% else %}
              {% render 'empty', message: '暂无内容', icon: 'document' %}
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="grid grid-cols-1 p-1 mt-6 border-t border-gray-200 md:grid-cols-12">
          <div class="my-4 text-center md:col-span-12">
            {% render 'paginate', paginate: paginate %}
          </div>
        </div>
        {% endpaginate_tag %}
        <div class="hidden user-profile-sidebar">
          <div class="px-3 pt-3 px-lg-4 pt-lg-4">
            <div class="user-chat-nav text-end">
              <button type="button" class="btn nav-btn" id="user-profile-hide">
                <i class="ri-close-line"></i>
              </button>
            </div>
          </div>

          <div class="p-4 text-center border-bottom">
            <div class="mb-4">
              <img src="assets/images/users/avatar-4.jpg" class="rounded-circle avatar-lg img-thumbnail" alt="">
            </div>

            <h5 class="mb-1 font-size-16 text-truncate">Doris Brown</h5>
            <p class="mb-1 text-muted text-truncate"><i
                class="ri-record-circle-fill font-size-10 text-success me-1 ms-0"></i> Active</p>
          </div>
          <!-- End profile user -->

          <!-- Start user-profile-desc -->

          <!-- end user-profile-desc -->
        </div>
      </div>
      <!-- End User chat -->
    </div>
    <!-- end  layout wrapper -->
  </turbo-frame>
</div>
