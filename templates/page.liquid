{% assign search_ask_ai_message_tpl = 'search.ask_ai_message' | t: '请介绍一下「%{query}」' %}
{% assign chat_static_url = statics['chat'] %}
{% assign search_preview_url = statics['search_preview'] %}
{% assign index_page = site.pages['/'] %}
{% assign hot_keywords = index_page.settings.popular_searches | reg_split: "/\n/" %}

<div
  class="flex min-h-0 min-w-0 flex-1 overflow-hidden w-full"
  data-controller="header-search"
  data-header-search-search-url-value="{{ site.search_path }}"
  data-header-search-preview-url-value="{{ search_preview_url }}"
  data-header-search-chat-url-value="{{ chat_static_url }}"
  data-header-search-ask-ai-message-template-value="{{ search_ask_ai_message_tpl | escape_once }}"
>
  <!-- left_sidebar：文档目录 -->
  <div class="hidden h-full min-h-0 min-w-[320px] max-w-[400px] shrink-0 overflow-auto border-r border-base-content/10 bg-base-100 lg:block">
    <div class="sticky top-0 bg-white z-10 py-6 px-4">
      <button
        type="button"
        class="flex h-10 w-full items-center gap-2 rounded-xl border border-base-content/10 bg-base-100 px-3 text-left text-sm text-base-content/45 transition hover:border-primary/30 hover:ring-2 hover:ring-primary/10"
        data-action="click->header-search#openModal"
        aria-label="{{ 'templates.page.search_docs' | t: '搜索文档' }}"
      >
        <i class="ri-search-line shrink-0 text-base text-base-content/40" aria-hidden="true"></i>
        <span class="min-w-0 flex-1 truncate">{{ 'templates.page.search_docs_placeholder' | t: '搜索文档…' }}</span>
        <kbd class="hidden shrink-0 rounded border border-base-content/10 px-1.5 py-0.5 text-[0.65rem] text-base-content/40 lg:inline">⌘K</kbd>
      </button>
    </div>

    <div class="page-nav-tree py-6 px-4 pt-0">
      {% render 'nav_tree_switch', page: site.pages['/'], current_path: page.path %}
    </div>
  </div>

  <turbo-frame id="page-content" class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden bg-base-100" x-data="{ isDrawerOpen: false }">
    <div class="drawer flex min-h-0 min-w-0 flex-1 flex-col">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" x-model="isDrawerOpen" />
      <div class="drawer-content flex min-h-0 min-w-0 flex-1 flex-col">
        <div
          class="js-page-topbar flex h-14 shrink-0 items-center gap-3 border-b border-base-content/8 bg-base-100/75 px-4 backdrop-blur-xl sm:h-16 sm:px-6 lg:h-16 lg:px-8"
        >
          <label for="my-drawer" class="btn btn-square btn-ghost btn-sm flex-none lg:hidden" aria-label="{{ 'templates.page.nav_drawer' | t: '目录' }}">
            <i class="ri-menu-line text-xl" aria-hidden="true"></i>
          </label>

          <h5 class="mb-0 min-w-0 flex-1 truncate text-sm font-semibold sm:text-base">
            {% render 'breadcrumb', breadcrumb: page.breadcrumb %}
          </h5>
        </div>

        <div class="min-h-0 flex-1 overflow-y-auto px-4 py-6 md:px-8">
          <div
            class="group mx-auto w-full max-w-3xl lg:max-w-[calc(var(--container-3xl)+15rem)]"
            data-controller="toc"
            data-toc-header-selector-value=".js-page-topbar"
            data-toc-offset-value="16"
            data-toc-title-value="{{ 'templates.page.page_toc' | t: '页内目录' }}"
            data-toc-clipboard-success-value="{{ 'templates.page.copy_success' | t: '链接已复制' }}"
          >
            <div class="grid w-full grid-cols-1 gap-8 lg:group-[.has-toc]:grid-cols-[minmax(0,var(--container-3xl))_minmax(11rem,15rem)]">
              <main class="min-w-0">
                {% render 'page_content', page: page, chat_url: chat_static_url %}
                {% render 'footer' %}
              </main>

              <aside
                class="sticky top-0 hidden w-full min-w-0 max-h-[calc(100dvh-var(--header-height)-5rem)] overflow-y-auto text-[0.85rem] print:hidden lg:group-[.has-toc]:block"
                aria-label="{{ 'templates.page.page_toc' | t: '页内目录' }}"
              >
                <div data-toc-target="menu">
                  <p class="mb-2 flex items-center gap-2 font-bold text-base-content">
                    <i class="ri-list-unordered text-base text-base-content/50" aria-hidden="true"></i>
                    {{ 'templates.page.page_toc' | t: '页内目录' }}
                  </p>
                  <div data-toc-target="links"></div>
                </div>
              </aside>
            </div>
          </div>
        </div>
      </div>

      <div class="drawer-side z-20 lg:hidden">
        <label for="my-drawer" class="drawer-overlay bg-black/20 backdrop-blur-sm"></label>
        <div
          class="menu h-full w-80 overflow-auto border border-base-content/10 bg-base-100 p-4 text-base-content"
          @click.capture="if ($event.target.closest('a[href]')) isDrawerOpen = false"
        >
          <div class="page-nav-tree">
            <button
              type="button"
              class="mb-4 flex h-10 w-full items-center gap-2 rounded-xl border border-base-content/10 bg-base-100 px-3 text-left text-sm text-base-content/45"
              data-action="click->header-search#openModal"
            >
              <i class="ri-search-line shrink-0 text-base text-base-content/40" aria-hidden="true"></i>
              <span class="truncate">{{ 'templates.page.search_docs_and_ai' | t: '搜索文档、向 AI 提问…' }}</span>
            </button>
            {% render 'nav_tree_switch', page: site.pages['/'], current_path: page.path %}
          </div>
        </div>
      </div>
    </div>
  </turbo-frame>

  {% render 'search_modal', hot_keywords: hot_keywords %}
</div>

{% schema %}
{
"name": "t:schema.templates.page.name",
"description": "t:schema.templates.page.description",
"thumb_url": "images/theme/page.png",
"sub_page_templates": ["page"],
"settings": [
{
"id": "show_list",
"type": "checkbox",
"default": false,
"label": "t:schema.templates.page.settings.show_list.label",
"info": "t:schema.templates.page.settings.show_list.info"
},
{
"id": "icon",
"type": "image_picker",
"ratio": "1:1",
"width": 100,
"label": "t:schema.templates.page.settings.icon.label",
"info": "t:schema.templates.page.settings.icon.info"
},
{
"id": "title",
"type": "text",
"readonly": true,
"label": "t:schema.templates.page.settings.title.label",
"info": "t:schema.templates.page.settings.title.info"
},
{
"id": "description",
"type": "textarea",
"label": "t:schema.templates.page.settings.description.label"
},
{
"id": "tags",
"type": "tag_picker",
"multiple": true,
"label": "t:schema.templates.page.settings.tags.label",
"query_enabled": true
},
{
"id": "thumb_image_url",
"type": "image_picker",
"width": 400,
"height": 225,
"label": "t:schema.templates.page.settings.thumb_image_url.label"
},
{
"id": "content",
"type": "richtext",
"label": "t:schema.templates.page.settings.content.label",
"readonly": true,
"info": "t:schema.templates.page.settings.content.info"
}
]
}
{% endschema %}
