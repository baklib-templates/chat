{%# locals:(nav_tree:, depth: 0, class: '') %}
{% comment %} {% unless depth %}
  {% assign depth = 0 %}
{% endunless %}
{% if depth == 0 %}
  <ul class="menu w-full {{ class }}" id="nav-tree" data-turbo-permanent data-controller="nav-tree" data-nav-tree-active-class="menu-active">
{% else %}
  <ul>
{% endif %}
  {% for tree in nav_tree %}
    {% if tree.children %}
      <li class='mt-1'>
        <details>
          <summary data-nav-tree-target="item"><a href="{{ tree.path }}" class="{% if depth == 0 %}font-semibold text-primary text-base	 {% endif %}">{{ tree.link_text }}</a></summary>
          {% assign newDepth = depth | plus: 1 %}
          {% render 'sub_nav_tree', nav_tree: tree.children, depth: newDepth %}
        </details>
      </li>
    {% else %}
      <li class='mt-1'>
        <summary>
          <a data-nav-tree-target="item" href="{{ tree.path }}" class="{% if depth == 0 %}font-semibold text-primary text-base	{% endif %}">{{ tree.link_text }}</a>
        </summary>
      </li>
    {% endif %}
  {% endfor %}
</ul> {% endcomment %}


{%# locals:(nav_tree:, depth: 0, class: '') %}
<ul>
  {% for tree in nav_tree %}
    {% if tree.children %}
      <li class='mt-1'>
        <details>
          <summary data-nav-tree-target="item" class='hover:bg-transparent hover:text-primary'><a href="{{ tree.path }}"  data-turbo-frame="page-content" >{{ tree.link_text }}</a></summary>
          {% assign newDepth = depth | plus: 1 %}
          {% render 'sub_nav_tree', nav_tree: tree.children, depth: newDepth %}
        </details>
      </li>
    {% else %}
      <li class='mt-1'>
        <summary class='hover:bg-transparent hover:text-primary'>
          <a data-nav-tree-target="item" href="{{ tree.path }}"  data-turbo-frame="page-content">{{ tree.link_text }}</a>
        </summary>
      </li>
    {% endif %}
  {% endfor %}
</ul>
