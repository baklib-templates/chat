{% assign logo_url = site.settings.logo_url | presence %}
<div class="sm:flex">
    {% render 'sidebar' %}

    <!-- start chat-leftsidebar -->
    <div class=" min-w-[320px] max-w-[400px]  bg-base-200 border-r border-base-300 px-8 py-8 hidden sm:block">

        <div class="mb-6">
            <div class="flex justify-center items-center p-6 rounded-lg shadow-sm bg-base-100">
                {% if logo_url %}
                <img src="{{ logo_url }}" alt="{{ site.name | escape_once }}" class="mr-4 w-12 h-12">
                {% else %}
                {% assign favicon_url = site.favicon_url | presence %}
                {% if favicon_url %}
                <img src="{{ favicon_url }}" alt="{{ site.name | escape_once }}" class="mr-4 w-12 h-12">
                {% endif %}
                {% endif %}
                <span class="text-4xl font-bold text-base-content/80"> {{ site.settings.brand_name }} </span>
            </div>
        </div>

        <!-- 网站名称和公司 -->
        <div class="mb-6">
            <div class="text-center">
                <div class="mb-1 text-xl font-bold">{{ site.name }}</div>
                {% if site.settings.company_name %}
                <div class="flex justify-center items-center text-base text-base-content/50">
                    <span class="inline-block mr-2 w-2 h-2 rounded-full bg-secondary"></span>
                    {{ site.settings.company_name }}
                </div>
                {% endif %}
            </div>
        </div>

        <!-- 简介 -->
        <div class="mb-6">
            <p class="leading-relaxed text-base-content/50">
                {{ site.settings.site_description }}
            </p>
        </div>

        {% if site.settings.quick_navigation_html %}
            <div class="w-full max-w-md shadow-md bg-base-100 rounded-box">
                <div class="bg-base-100 collapse collapse-arrow">
                    <input type="checkbox" class="peer" checked />
                    <div class="flex gap-2 items-center text-base font-semibold text-base-content/90 collapse-title">
                        快捷导航
                    </div>
                    <div class="leading-6 text-base-content/80 collapse-content">
                        {{ site.settings.quick_navigation_html }}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
    <!-- end chat-leftsidebar -->

    <!-- Start User chat -->
    <div class="overflow-hidden w-full bg-base-100">
        <div class="sm:flex">
            <div class="flex flex-col flex-1 min-h-screen">
                <!-- 欢迎语 -->
                <div class="flex justify-between items-center px-8 h-20 border-b bg-base-100 border-base-content/15">
                    <!-- 左侧绿色小圆点 -->
                    <span><i class="ri-record-circle-fill font-size-10 text-secondary d-inline-block ms-1"></i></span>
                    <!-- 右侧更多操作 -->
                </div>

                <div class="h-[calc(100vh-184px)] flex items-center justify-center px-4 py-16 text-center">
                    <div class="-mt-20 w-full">
                        <!-- 顶部欢迎区域 -->
                        <div class="mb-10 text-center">
                            <h1 class="text-3xl font-semibold">
                                {{ site.settings.welcome_title }}
                            </h1>
                            <p
                                class="mx-auto mt-4 max-w-3xl text-lg font-normal text-left text-base-content/50 indent-8">
                                {{ site.settings.welcome_description }}
                            </p>
                        </div>

                        <!-- 输入框 -->
                        {% form_tag 'search', class: 'mx-auto w-full max-w-3xl' %}
                        <div class="flex flex-col px-6 pt-6 pb-3 rounded-2xl shadow bg-base-300">
                            <!-- 输入区 -->
                            <textarea rows="1"
                                class="w-full resize-none bg-transparent border-none outline-none text-base font-normal  min-h-[40px] max-h-32"
                                placeholder="输入问题"   name="{{form.keywords_field_name}}" value="{{ search.keywords | escape_once }}" autocomplete="off"
                                onkeydown="if(event.key==='Enter'){event.preventDefault(); this.form.submit();}"
                                ></textarea>
                            <!-- 底部按钮区 -->
                            <div class="flex items-center mt-4">
                                <div class="flex-1"></div>
                                <!-- 右侧按钮 -->
                                <button type="submit"
                                    class="flex justify-center items-center ml-2 w-9 h-9 rounded-full transition cursor-pointer text-primary bg-primary/10 hover:bg-primary/20">
                                    <!-- 发送icon -->
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2"
                                        viewBox="0 0 24 24">
                                        <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round"
                                            stroke-linejoin="round" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                        {% endform_tag %}
                    </div>
                </div>

                {% assign company_name = site.settings.company_name | presence %}
                {% assign copyright = site.settings.copyright | presence %}
                <div class="p-1 sm:border-t border-base-content/15">
                    <div class="w-full text-center text-xs text-base-content/60 py-4">
                        {% if  site.settings.company_name %}
                        <span>© {{  site.settings.company_name }} {{ 'snippets.footer.copyright' | t }}</span>
                        {% endif %}
                         {% if copyright %}
                        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer"  class="hover:underline">{{ copyright }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        <!-- End User chat -->
    </div>
    <!-- end  layout wrapper -->
</div>

{% schema %}
{
"name": "t:schema.templates.index.name",
"description": "t:schema.templates.index.description",
"thumb_url": "images/theme/index-preview.png",
"sub_page_templates": [
"page"
]
}
{% endschema %}