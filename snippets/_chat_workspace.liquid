{% comment %}
  AI 对话工作区：引用来源侧栏 + 消息区 + 输入框（配合 ai-search / ai-pip）
  chat_id: 会话 hashid；initial_message: 首条自动发送内容
{% endcomment %}

{% assign resolved_chat_id = chat_id | default: params.id | default: params.chat_id | strip %}
{% assign chat = site.ai_chats[resolved_chat_id] %}
{% assign chat_has_title = chat.title | presence %}
{% assign chat_title_url = statics['chat_title'] %}
{% assign is_historical_chat = false %}
{% if chat and chat.messages.size > 0 %}
  {% assign is_historical_chat = true %}
{% endif %}

{% assign robot_name = site.settings.robot_name %}
{% assign ai_reading_text = 'ai.reading' | t: '正在阅读文档…' %}
{% assign ai_thinking_status = 'ai.thinking' | t: 'AI 正在思考' %}
{% assign ai_network_error = 'ai.network_error' | t: '网络错误，请重试' %}
{% assign ai_timeout_error = 'ai.timeout_error' | t: '响应超时，请重试' %}
{% assign ai_copy_success = 'ai.copy_success' | t: '已复制' %}
{% assign ai_copy_error = 'ai.copy_error' | t: '复制失败' %}
{% assign ai_completed_text = site.settings.ai_search_completed_text %}
{% assign chat_input_placeholder = 'snippets.chat.input_placeholder' | t: '输入问题，Enter 发送' %}
{% assign chat_continue_placeholder = 'snippets.chat.continue_input_placeholder' | t: '继续提问…' %}
{% assign chat_send_label = 'snippets.chat.send' | t: '发送' %}
{% assign pip_unsupported = 'snippets.chat.pip_unsupported' | t: '当前浏览器不支持独立窗口' %}
{% assign pip_pop_out = 'snippets.chat.pip_pop_out' | t: '独立窗口' %}
{% assign pip_dock = 'snippets.chat.pip_dock' | t: '收回页面' %}
{% assign pip_opened = 'snippets.chat.pip_opened' | t: 'AI 助手已在独立窗口中打开' %}
{% assign auto_submit = false %}
{% if initial_message != blank %}
  {% assign auto_submit = true %}
{% endif %}
{% capture ai_search_messages_json %}{"thinking":{{ ai_thinking_status | to_json }},"reading":{{ ai_reading_text | to_json }},"thinking_status":{{ ai_thinking_status | to_json }},"completed":{{ ai_completed_text | to_json }},"network_error":{{ ai_network_error | to_json }},"timeout_error":{{ ai_timeout_error | to_json }},"copy_success":{{ ai_copy_success | to_json }},"copy_error":{{ ai_copy_error | to_json }}}{% endcapture %}

<div
  class="relative flex min-h-0 min-w-0 flex-1 overflow-hidden w-full"
  data-controller="ai-pip"
  data-ai-pip-unsupported-message-value="{{ pip_unsupported | escape_once }}"
  data-ai-pip-pop-out-label-value="{{ pip_pop_out | escape_once }}"
  data-ai-pip-dock-label-value="{{ pip_dock | escape_once }}"
>

  <div
    class="relative flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden"
    data-controller="ai-search"
    data-ai-search-url-value="/-/ai-search-completion"
    data-ai-search-chats-url-value="/-/ai_chats"
    data-ai-search-timeout-value="60"
    data-ai-search-chat-id-value="{{ chat_id }}"
    data-ai-search-auto-submit-value="{{ auto_submit }}"
    data-ai-search-has-chat-title-value="{% if chat_has_title %}true{% else %}false{% endif %}"
    data-ai-search-is-historical-chat-value="{% if is_historical_chat %}true{% else %}false{% endif %}"
    data-ai-search-chat-title-url-value="{{ chat_title_url }}"
    data-ai-search-messages-value="{{ ai_search_messages_json | escape_once }}"
  >
    <div data-ai-pip-target="panel" class="relative flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden">
      {% render 'ai_chat_messages', chat: chat, ai_completed_text: ai_completed_text %}

      <footer class="shrink-0 border-t border-base-content/8 bg-base-100/90 px-3 py-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur-xl sm:px-6 sm:py-4">
        <div class="group relative mx-auto w-full max-w-[50rem]">
          <div
            class="pointer-events-none absolute -inset-3 rounded-[1.35rem] bg-linear-to-r from-primary/35 via-secondary/30 to-accent/35 opacity-80 blur-2xl transition-all duration-500 group-has-focus-within:opacity-100 group-has-focus-within:blur-3xl"
            aria-hidden="true"
          ></div>
          <div
            class="relative rounded-2xl bg-linear-to-r from-primary/55 via-secondary/45 to-accent/50 p-px shadow-[0_12px_40px_-14px] shadow-primary/25 transition-shadow duration-500 group-has-focus-within:shadow-[0_16px_48px_-12px] group-has-focus-within:shadow-primary/35"
          >
            <div class="relative flex items-end gap-1.5 rounded-[calc(1rem-1px)] border border-base-content/8 bg-base-100 p-1.5 shadow-sm transition-all group-has-focus-within:border-primary/25 group-has-focus-within:ring-2 group-has-focus-within:ring-primary/15 sm:gap-2 sm:p-2">
              <textarea
                rows="1"
                data-ai-search-target="input"
                data-action="input->ai-search#syncSendButton keydown->ai-search#onInputKeydown"
                autocomplete="off"
                placeholder="{{ chat_input_placeholder | escape_once }}"
                class="max-h-32 min-h-[40px] flex-1 resize-none border-none bg-transparent px-1 py-2 text-sm outline-none placeholder:text-base-content/45 sm:min-h-[48px] sm:py-2.5 sm:text-base"
                oninput="this.style.height='auto';this.style.height=this.scrollHeight+'px'"
              ></textarea>
              <button
                type="button"
                data-ai-search-target="send"
                data-action="click->ai-search#send"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-content shadow-md transition-all hover:brightness-110 active:scale-95 disabled:cursor-not-allowed disabled:opacity-40 sm:h-11 sm:w-11"
                aria-label="{{ chat_send_label | escape_once }}"
                disabled
              >
                <i class="ri-send-plane-2-fill text-lg" aria-hidden="true"></i>
              </button>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <div
      data-ai-pip-target="placeholder"
      class="hidden min-h-0 flex-1 flex-col items-center justify-center gap-3 px-6 text-center text-sm text-base-content/60"
    >
      <i class="ri-picture-in-picture-2-line text-3xl text-primary/80" aria-hidden="true"></i>
      <p>{{ pip_opened }}</p>
      <button type="button" class="btn btn-outline btn-sm" data-action="click->ai-pip#dock">{{ pip_dock }}</button>
    </div>

    <template data-ai-pip-target="shellTemplate">
      <div class="flex h-screen flex-col bg-base-100 text-base-content" data-controller="ai-search">
        <div class="flex shrink-0 items-center justify-between border-b border-base-content/10 px-4 py-3">
          <div class="flex items-center gap-2 text-sm font-bold">
            <i class="ri-sparkling-2-line text-primary" aria-hidden="true"></i>
            {{ robot_name }}
          </div>
          <button type="button" class="btn btn-ghost btn-sm btn-square" data-ai-pip-dock aria-label="{{ pip_dock | escape_once }}">
            <i class="ri-layout-left-line text-base" aria-hidden="true"></i>
          </button>
        </div>
        {% render 'ai_chat_messages',
          wrapper_class: 'flex-1 min-h-0 overflow-y-auto',
          messages_class: 'ai-chat-messages !px-4 !py-4',
          chat: chat,
          ai_completed_text: ai_completed_text
        %}
        <div class="shrink-0 border-t border-base-content/10 px-4 py-3">
          <div class="flex items-end gap-2 rounded-2xl border border-base-content/10 p-2 focus-within:border-primary/40">
            <textarea
              rows="1"
              data-ai-search-target="input"
              data-action="input->ai-search#syncSendButton keydown->ai-search#onInputKeydown"
              class="max-h-28 min-h-[44px] flex-1 resize-none border-none bg-transparent py-2 text-sm outline-none"
              placeholder="{{ chat_continue_placeholder | escape_once }}"
            ></textarea>
            <button
              type="button"
              data-ai-search-target="send"
              data-action="click->ai-search#send"
              class="btn btn-circle btn-sm bg-primary text-primary-content"
              disabled
              aria-label="{{ chat_send_label | escape_once }}"
            >
              <i class="ri-send-plane-2-fill" aria-hidden="true"></i>
            </button>
          </div>
        </div>
        {% render 'ai_message_templates', robot_name: robot_name %}
      </div>
    </template>

    {% render 'ai_message_templates', robot_name: robot_name %}
  </div>
</div>
