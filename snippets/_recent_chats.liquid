{% comment %}
  左侧「最近」会话列表（可被 turbo-frame 独立刷新）
  current_chat_id: 当前高亮的会话 id
  chat_page_url: 会话静态页 URL
{% endcomment %}

{%- assign recent_chats = site.ai_chats | limit: 20 -%}
{%- assign chat_page_url = chat_page_url | default: statics['chat'] -%}
{%- assign current_chat_id = current_chat_id | strip -%}
{%- assign chat_delete_enabled = site.settings.chat_delete_enabled -%}
{%- if chat_delete_enabled -%}
  {%- assign delete_chat_label = 'snippets.recent_chats.delete' | t: '删除对话' -%}
{%- endif -%}

{% if recent_chats %}
  <div class="mt-4 pt-3">
    <details open class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between px-2 py-1.5 text-xs font-semibold text-base-content [&::-webkit-details-marker]:hidden sticky top-0 bg-base-100">
        <span>{{ 'snippets.sidebar.recent' | t: '最近' }}</span>
        <i class="ri-arrow-down-s-line text-base text-base-content/40 transition-transform group-open:rotate-180" aria-hidden="true"></i>
      </summary>
      <ul class="mt-1 flex flex-col space-y-1">
        {% for chat in recent_chats %}
          {% assign chat_title = chat.title | default: '' %}
          {% if chat_title == blank %}
            {% assign chat_title = 'snippets.recent_chats.new_chat' | t: '新对话' %}
          {% endif %}
          {% assign chat_has_title = chat.title | presence %}
          <li
            class="{% if chat_delete_enabled %}group/chat relative{% endif %}"
            {% if chat_delete_enabled %}
              data-recent-chats-target="chatItem"
              data-chat-id="{{ chat.id }}"
            {% endif %}
          >
            <a
              href="{{ chat_page_url }}?id={{ chat.id }}"
              class="block truncate rounded-lg py-2 px-2{% if chat_delete_enabled %} pl-2 pr-8{% endif %} text-sm text-base-content/80 transition-colors hover:bg-base-content/5 hover:text-base-content{% if current_chat_id == chat.id %} bg-base-content/5 font-medium text-base-content{% endif %}"
              data-turbo-frame="_top"
              data-recent-chats-target="chatLink"
              data-chat-id="{{ chat.id }}"
              data-has-title="{% if chat_has_title %}true{% else %}false{% endif %}"
              title="{{ chat_title | escape_once }}"
            >{{ chat_title | escape_once }}</a>
            {% if chat_delete_enabled %}
              <button
                type="button"
                class="absolute right-0.5 top-1/2 flex h-7 w-7 -translate-y-1/2 items-center justify-center rounded-md text-base-content/35 opacity-0 transition-all hover:bg-error/10 hover:text-error focus-visible:opacity-100 group-hover/chat:opacity-100 group-focus-within/chat:opacity-100 cursor-pointer"
                data-action="click->recent-chats#deleteChat"
                data-chat-id="{{ chat.id }}"
                aria-label="{{ delete_chat_label | escape_once }}"
                title="{{ delete_chat_label | escape_once }}"
              >
                <i class="ri-delete-bin-line text-sm leading-none" aria-hidden="true"></i>
              </button>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </details>
  </div>
{% endif %}
