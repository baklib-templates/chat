{% for tag in site.tags %}
  {% assign first_tag = tag %}
  {% break %}
{% endfor %}

<!-- Start left sidebar-menu -->
<div class="flex z-10 flex-shrink-0 min-h-screen sm:flex-col glass side-menu" >
  <!-- LOGO -->
  <div class="hidden justify-center items-center sm:flex">
    <a href="/" class="tooltip tooltip-top" data-tip="{{ site.name | escape_once }}">
      <span class="logo-sm">
          {% assign favicon_url = site.favicon_url | presence %}
          {% if favicon_url %}
            <img src="{{ favicon_url }}" alt="{{ site.name | escape_once }}" class="m-4 w-8" >
          {% endif %}
      </span>
    </a>
  </div>
  <!-- end navbar-brand-box -->

  <!-- Start side-menu nav -->
  <div class="flex justify-center my-auto sm:flex-col">
    <ul class="flex justify-center items-center sm:flex-col gap-8 md:gap-4" data-controller="nav-tree" data-nav-tree-active-class="sidebar-menu-active">
      {%- assign current_path = page.path | default: "/" -%}
      <li class="m-2 tooltip tooltip-top" data-tip="新会话" >
        <a
          class="flex justify-center items-center w-12 h-12 rounded-glass-sm glass hover:shadow-glass transition-all duration-200 text-base-content hover:text-primary {% if current_path == "" %} bg-primary/90 text-primary-content {% endif %}"
          href="/"
          role="tab"
          data-nav-tree-target="item">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 w-6 h-6{% if current_path == "" %} text-primary-content {% endif %}">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 0 1-.923 1.785A5.969 5.969 0 0 0 6 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337Z" />
          </svg>
        </a>
      </li>

      <li class="m-2 tooltip tooltip-top" data-tip="历史会话">
        <a
          id="js-history-link"
          class="flex justify-center items-center w-12 h-12 rounded-glass-sm glass hover:shadow-glass transition-all duration-200 text-base-content hover:text-primary {% if current_path == "" %} bg-primary/90 text-primary-content {% endif %}"
          href="/-/search"
          role="tab"
          data-nav-tree-target="item">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 w-6 h-6{% if current_path == "" %} text-primary-content {% endif %}">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
          </svg>
        </a>
      </li>
    
      {% assign item = site.pages['/'].children_in_list | first %}
      <li class="m-2 tooltip tooltip-top" data-tip="知识库" data-nav-tree-target="item">
        <a
          class="flex justify-center items-center w-12 h-12 rounded-glass-sm glass hover:shadow-glass transition-all duration-200 text-base-content hover:text-primary{% if current_path == item.path %} bg-primary/90 text-primary-content{% endif %}"
          href="{{ item.path }}"
          role="tab"
          data-nav-tree-target="item">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 w-6 h-6{% if current_path == item.path %} text-primary-content{% endif %}">
            <path fill-rule="evenodd" d="M2.625 6.75a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Zm4.875 0A.75.75 0 0 1 8.25 6h12a.75.75 0 0 1 0 1.5h-12a.75.75 0 0 1-.75-.75ZM2.625 12a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0ZM7.5 12a.75.75 0 0 1 .75-.75h12a.75.75 0 0 1 0 1.5h-12A.75.75 0 0 1 7.5 12Zm-4.875 5.25a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Zm4.875 0a.75.75 0 0 1 .75-.75h12a.75.75 0 0 1 0 1.5h-12a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
          </svg>
        </a>
      </li>

      {% if site.settings.section_tags_on %}
        <li class="m-2 tooltip tooltip-top" data-tip="标签分类">
          <a class="flex justify-center items-center w-12 h-12 rounded-glass-sm glass hover:shadow-glass transition-all duration-200 text-base-content hover:text-primary {% if tag %}
            sidebar-active
          {% endif %}"
          href="{% if first_tag %}{{ first_tag.path }}{% else %}/s/tags{% endif %}"
            role="tab" data-nav-tree-target="item">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 w-6 h-6{% if tag %} text-primary-content{% endif %}">
              <path fill-rule="evenodd" d="M1.5 7.125c0-1.036.84-1.875 1.875-1.875h6c1.036 0 1.875.84 1.875 1.875v3.75c0 1.036-.84 1.875-1.875 1.875h-6A1.875 1.875 0 0 1 1.5 10.875v-3.75Zm12 1.5c0-1.036.84-1.875 1.875-1.875h5.25c1.035 0 1.875.84 1.875 1.875v8.25c0 1.035-.84 1.875-1.875 1.875h-5.25a1.875 1.875 0 0 1-1.875-1.875v-8.25ZM3 16.125c0-1.036.84-1.875 1.875-1.875h5.25c1.036 0 1.875.84 1.875 1.875v2.25c0 1.035-.84 1.875-1.875 1.875h-5.25A1.875 1.875 0 0 1 3 18.375v-2.25Z" clip-rule="evenodd" />
            </svg>
          </a>
        </li>
      {% endif %}

    </ul>
  </div>
  <!-- end side-menu nav -->

  <div class="hidden justify-center sm:flex">
    <ul class="nav side-menu-nav justify-content-center">
      <li class="m-2 tooltip tooltip-top" data-tip="切换主题">
        <label class="items-center w-12 h-12 swap swap-rotate">
          <!-- this hidden checkbox controls the state -->
          <input type="checkbox" class="theme-controller" value="dark" />

          <!-- sun icon -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 w-6 h-6 swap-off">
            <path d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-2.25A.75.75 0 0 1 12 18ZM7.758 17.303a.75.75 0 0 0-1.061-1.06l-1.591 1.59a.75.75 0 0 0 1.06 1.061l1.591-1.59ZM6 12a.75.75 0 0 1-.75.75H3a.75.75 0 0 1 0-1.5h2.25A.75.75 0 0 1 6 12ZM6.697 7.757a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 0 0-1.061 1.06l1.59 1.591Z" />
          </svg>
          <!-- moon icon -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 w-6 h-6 swap-on">
            <path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.7-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z" clip-rule="evenodd" />
          </svg>

        </label>
      </li>

      {% if current_user %}
        <li class="m-2 btn-group dropdown dropdown-top">
          <a class="flex justify-center items-center w-12 h-12 rounded-glass-sm glass hover:shadow-glass transition-all duration-200 text-base-content hover:text-primary" href="#" role="button" tabindex="0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 w-6 h-6">
              <path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0 0 21.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 0 0 3.065 7.097A9.716 9.716 0 0 0 12 21.75a9.716 9.716 0 0 0 6.685-2.653Zm-12.54-1.285A7.486 7.486 0 0 1 12 15a7.486 7.486 0 0 1 5.855 2.812A8.224 8.224 0 0 1 12 20.25a8.224 8.224 0 0 1-5.855-2.438ZM15.75 9a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" clip-rule="evenodd" />
            </svg>  
          </a>
          <ul tabindex="0" class="p-2 w-44 shadow-glass dropdown-content menu glass rounded-glass z-1">
            <a class="px-4 py-2 font-normal text-left rounded cursor-pointer text-base-content/80 hover:bg-base-300 hover:text-primary focus:bg-base-300"  href="{{ current_user.profile_url }}">  
            {{ 'generic.profile' | t }} 
            </a>
            {% form_tag 'sign_out' %}
              <button class="px-4 py-2 w-full font-normal text-left rounded cursor-pointer text-base-content/80 hover:bg-base-300 hover:text-primary focus:bg-base-300" href="auth-login.html">{{ 'buttons.logout' | t }} 
              </button>
            {% endform_tag %}
          </ul>
        </li>
      {% else %}
        <li class="m-2" title="点击登录">
          <div class="flex justify-center items-center hover:text-primary">
            {% form_tag 'sign_in_with_baklib' %}
              <input value="true" type="hidden" name="sign_up">
              <button type="submit" data-disable-with=" ... ">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 w-8 h-8">
                  <path fill-rule="evenodd" d="M18.685 19.097A9.723 9.723 0 0 0 21.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 0 0 3.065 7.097A9.716 9.716 0 0 0 12 21.75a9.716 9.716 0 0 0 6.685-2.653Zm-12.54-1.285A7.486 7.486 0 0 1 12 15a7.486 7.486 0 0 1 5.855 2.812A8.224 8.224 0 0 1 12 20.25a8.224 8.224 0 0 1-5.855-2.438ZM15.75 9a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" clip-rule="evenodd" />
                </svg>
              </button>
            {% endform_tag %}
          </div>
        </li>
      {% endif %}
    </ul>
  </div>
  <!-- Side menu user -->
</div>
