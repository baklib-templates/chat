{% comment %}
  AI 对话工作区：引用来源侧栏 + 消息区 + 输入框（配合 ai-search / ai-pip）
  chat_id: 会话 hashid；initial_message: 首条自动发送内容
{% endcomment %}
{% assign robot_name = site.settings.robot_name | default: 'AI 助手' %}
{% assign ai_reading_text = 'ai.reading' | t: '正在阅读文档…' %}
{% assign ai_thinking_status = 'ai.thinking' | t: 'AI 正在思考' %}
{% assign ai_network_error = 'ai.network_error' | t: '网络错误，请重试' %}
{% assign ai_timeout_error = 'ai.timeout_error' | t: '响应超时，请重试' %}
{% assign ai_copy_success = 'ai.copy_success' | t: '已复制' %}
{% assign ai_copy_error = 'ai.copy_error' | t: '复制失败' %}
{% assign ai_completed_text = site.settings.ai_search_completed_text | presence %}
{% unless ai_completed_text %}
  {% assign ai_completed_text = 'ai.completed' | t: 'AI 回答完毕.' %}
{% endunless %}
{% assign auto_submit = false %}
{% if initial_message != blank %}
  {% assign auto_submit = true %}
{% endif %}

<div
  class="relative flex min-h-0 min-w-0 flex-1 overflow-hidden w-full"
  data-controller="ai-pip"
  data-ai-pip-unsupported-message-value="当前浏览器不支持独立窗口"
  data-ai-pip-pop-out-label-value="独立窗口"
  data-ai-pip-dock-label-value="收回页面"
>

  <div
    class="relative flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden"
    data-controller="ai-search"
    data-ai-search-url-value="/-/ai-search-completion"
    data-ai-search-chats-url-value="/-/ai_chats"
    data-ai-search-timeout-value="60"
    data-ai-search-chat-id-value="{{ chat_id }}"
    data-ai-search-auto-submit-value="{{ auto_submit }}"
    data-ai-search-messages-value='{"thinking":"{{ ai_thinking_status | escape }}","reading":"{{ ai_reading_text | escape }}","thinking_status":"{{ ai_thinking_status | escape }}","completed":"{{ ai_completed_text | escape }}","network_error":"{{ ai_network_error | escape }}","timeout_error":"{{ ai_timeout_error | escape }}","copy_success":"{{ ai_copy_success | escape }}","copy_error":"{{ ai_copy_error | escape }}"}'
  >
    <div data-ai-pip-target="panel" class="relative flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden">
      {% render 'ai_chat_messages' %}

      <footer class="shrink-0 border-t border-base-content/8 bg-base-100/90 px-4 py-3 backdrop-blur-xl sm:px-6 sm:py-4">
        <div class="mx-auto w-full max-w-[50rem]">
          <div class="flex items-end gap-2 rounded-2xl border border-base-content/10 bg-base-100 p-2 shadow-lg transition-all focus-within:border-primary/40 focus-within:ring-2 focus-within:ring-primary/15">
            <textarea
              rows="1"
              data-ai-search-target="input"
              data-action="input->ai-search#syncSendButton keydown->ai-search#onInputKeydown"
              autocomplete="off"
              placeholder="输入您的问题，Enter 发送，Shift+Enter 换行…"
              class="max-h-32 min-h-[48px] flex-1 resize-none border-none bg-transparent px-1 py-2.5 text-base outline-none placeholder:text-base-content/45"
              oninput="this.style.height='auto';this.style.height=this.scrollHeight+'px'"
            ></textarea>
            <button
              type="button"
              data-ai-search-target="send"
              data-action="click->ai-search#send"
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-content shadow-md transition-all hover:brightness-110 active:scale-95 disabled:cursor-not-allowed disabled:opacity-40 sm:h-11 sm:w-11"
              aria-label="发送"
              disabled
            >
              <i class="ri-send-plane-2-fill text-lg" aria-hidden="true"></i>
            </button>
          </div>
          <div class="mt-2 flex items-center justify-between gap-2">
            <p class="text-[11px] leading-relaxed text-base-content/45">AI 仅基于当前知识库内容回答</p>
            <button
              type="button"
              class="btn btn-ghost btn-xs hidden text-base-content/50"
              data-ai-search-target="clearButton"
              data-action="click->ai-search#clearChat"
            >
              清空对话
            </button>
          </div>
        </div>
      </footer>
    </div>

    <div
      data-ai-pip-target="placeholder"
      class="hidden min-h-0 flex-1 flex-col items-center justify-center gap-3 px-6 text-center text-sm text-base-content/60"
    >
      <i class="ri-picture-in-picture-2-line text-3xl text-primary/80" aria-hidden="true"></i>
      <p>AI 助手已在独立窗口中打开</p>
      <button type="button" class="btn btn-outline btn-sm" data-action="click->ai-pip#dock">收回页面</button>
    </div>

    <template data-ai-pip-target="shellTemplate">
      <div class="flex h-screen flex-col bg-base-100 text-base-content" data-controller="ai-search">
        <div class="flex shrink-0 items-center justify-between border-b border-base-content/10 px-4 py-3">
          <div class="flex items-center gap-2 text-sm font-bold">
            <i class="ri-sparkling-2-line text-primary" aria-hidden="true"></i>
            {{ robot_name }}
          </div>
          <button type="button" class="btn btn-ghost btn-sm btn-square" data-ai-pip-dock aria-label="收回页面">
            <i class="ri-layout-left-line text-base" aria-hidden="true"></i>
          </button>
        </div>
        {% render 'ai_chat_messages',
          wrapper_class: 'flex-1 min-h-0 overflow-y-auto',
          messages_class: 'flex flex-col gap-6 px-4 py-4'
        %}
        <div class="shrink-0 border-t border-base-content/10 px-4 py-3">
          <div class="flex items-end gap-2 rounded-2xl border border-base-content/10 p-2 focus-within:border-primary/40">
            <textarea
              rows="1"
              data-ai-search-target="input"
              data-action="input->ai-search#syncSendButton keydown->ai-search#onInputKeydown"
              class="max-h-28 min-h-[44px] flex-1 resize-none border-none bg-transparent py-2 text-sm outline-none"
              placeholder="继续提问…"
            ></textarea>
            <button
              type="button"
              data-ai-search-target="send"
              data-action="click->ai-search#send"
              class="btn btn-circle btn-sm bg-primary text-primary-content"
              disabled
              aria-label="发送"
            >
              <i class="ri-send-plane-2-fill" aria-hidden="true"></i>
            </button>
          </div>
        </div>
        {% render 'ai_message_templates', robot_name: robot_name %}
      </div>
    </template>

    {% render 'ai_message_templates', robot_name: robot_name %}
  </div>
</div>
