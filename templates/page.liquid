<div class="sm:flex">
    {% render 'sidebar' %}
    <!-- end left sidebar-menu -->

    <!-- start chat-leftsidebar -->
    <div class="min-w-[380px] max-w-[400px] bg-base-200 border-r border-base-300 py-8 px-6 h-screen overflow-auto hidden sm:block">
        <h2 class="mb-4 text-xl font-semibold">目录导航</h2>

        <!-- 搜索框 -->
        {% form_tag 'search', class: 'w-full' %}
            <label class="flex gap-2 items-center mb-6 input focus:outline-none focus:ring-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 10-14 0 7 7 0 0014 0z" />
                </svg>
                <input type="text" class="grow" placeholder="搜索过滤..." placeholder="输入关键词过滤" name="{{form.keywords_field_name}}" value="{{ search.keywords | escape_once }}"
                placeholder="{{ "layout.theme.search_input_placeholder" | t }}"
                autocomplete="off" />
            </label>
        {% endform_tag %}

        {% render 'nav_tree', nav_tree: site.nav_tree %}
    </div>
    <!-- end chat-leftsidebar -->

    <!-- Start User chat -->
    <turbo-frame id="page-content" class="overflow-hidden w-full bg-base-100" x-data="{ isDrawerOpen: false }">
        <input id="my-drawer" type="checkbox" class="drawer-toggle"  x-model="isDrawerOpen" />
        <!-- 抽屉侧边栏 -->
        <div class="z-20 drawer-side">
            <label for="my-drawer" class="drawer-overlay"></label>
            <div class="overflow-auto p-4 w-80 h-screen menu bg-base-200 text-base-content">
            <!-- 点击任何链接都会关闭抽屉（因为 checkbox 被取消选中） -->

            {% render 'nav_tree', nav_tree: site.nav_tree %}
            </div>
        </div>
        <div class="sm:flex">
            <div class="flex flex-col flex-1 min-h-screen">
                <!-- 欢迎语 -->
                <div class="flex overflow-x-auto justify-between items-center px-8 h-20 border-b border-base-content/15 bg-base-100">
                    <label for="my-drawer" class="flex-none btn btn-square btn-ghost sm:hidden">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-5 h-5 stroke-current">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                      </svg>
                    </label>

                    <h5 class="mb-0 text-base text-truncate"> {% render 'breadcrumb', breadcrumb: page.breadcrumb %}
                    </h5>
                    <!-- 右侧更多操作 -->
                    <div class="flex space-x-2">
                        <a  data-turbo-stream="true"
                        href="{{ page.feedback_path }}" class="flex items-center space-x-1 text-base-content/50 hover:text-base-content/70">
                            <i class="{% if page.visitor_posted_feedback %}
                            ri-thumb-up-fill text-primary
                            {% else %}
                            ri-thumb-up-line
                            {% endif %} "></i>
                        </a>
                    </div>
                </div>

                <div class="h-[calc(100vh-100px)] overflow-y-auto p-4 relative first-letter:text">
                    {% if site.settings.show_author or site.settings.show_published_at %}
                    <section class="mt-2 mb-6">
                        {% if site.settings.show_author and site.settings.show_published_at %}
                        <div class="flex items-center space-y-2">
                            <div class="flex items-center space-x-2">
                                {% render 'avatar', url: page.author.avatar_url, name: page.author.name %}
                                <div class="flex flex-col space-y-0.5">
                                    <span class="text-xs">{{ page.author.name }}</span>
                                    <span class="text-xs text-base-content/60">{{ 'generic.published_at' | t }}: {{
                                        page.published_at | date: "%Y-%m-%d" }}</span>
                                </div>
                            </div>
                        </div>
                        {% elsif site.settings.show_author %}
                        {% render 'avatar_with_name', url: page.author.avatar_url, name: page.author.name %}
                        {% elsif site.settings.show_published_at %}
                        <p class="text-sm text-base-content/50 text-md">{{ 'generic.published_at' | t }}: {{
                            page.published_at | date: "%Y-%m-%d" }}</p>
                        {% endif %}
                    </section>
                    {% endif %}

                    {% # 标题 %}
                    {% assign title = page.settings.title | presence %}
                    {% if title %}
                    <header class="py-1 pl-2 mb-4 border-l-6 border-primary">
                        <h1 class="text-xl font-bold md:text-3xl lg:text-4xl">
                            {{ title }}
                        </h1>
                    </header>
                    {% endif %}

                    {% # 标签 %}
                    {% if page.settings.tags and page.settings.tags.size > 0 %}
                    <section class="flex flex-wrap gap-2 items-center px-4 mb-4">
                        {% for tag in page.settings.tags %}
                        {% render 'tag', tag: tag %}
                        {% endfor %}
                    </section>
                    {% endif %}

                    {% # 摘要 %}
                    {% assign description = page.settings.description | presence %}
                    {% if description %}
                    <section class="mb-4">
                        <blockquote class="p-4 italic rounded-lg bg-base-200 text-base-content/50">
                            <p>{{ description }}</p>
                        </blockquote>
                    </section>
                    {% endif %}

                    <article class="ProseMirror prose sm:prose-base lg:prose-lg">
                        {{ page.settings.content }}
                        <p></p>
                    </article>
                </div>

                <div class="p-1 border-t border-base-content/15">
                </div>
            </div>

            <div class="hidden user-profile-sidebar">
                <div class="px-3 pt-3 px-lg-4 pt-lg-4">
                    <div class="user-chat-nav text-end">
                        <button type="button" class="btn nav-btn" id="user-profile-hide">
                            <i class="ri-close-line"></i>
                        </button>
                    </div>
                </div>

                <div class="p-4 text-center border-bottom">
                    <div class="mb-4">
                        <img src="assets/images/users/avatar-4.jpg" class="rounded-circle avatar-lg img-thumbnail"
                            alt="">
                    </div>

                    <h5 class="mb-1 font-size-16 text-truncate">Doris Brown</h5>
                    <p class="mb-1 text-muted text-truncate"><i
                            class="ri-record-circle-fill font-size-10 text-success me-1 ms-0"></i> Active</p>
                </div>
                <!-- End profile user -->

                <!-- Start user-profile-desc -->

                <!-- end user-profile-desc -->
            </div>
        </div>
        <!-- End User chat -->
    </turbo-frame>
    <!-- end  layout wrapper -->
</div>

{% schema %}
{
"name": "t:schema.templates.help-center-list.name",
"description": "t:schema.templates.help-center-list.description",
"thumb_url": "",
"sub_page_templates": ["page"],
"settings": [
{
"id": "tags",
"type": "tag_picker",
"multiple": true,
"label": "t:schema.templates.page.settings.tags.label",
"query_enabled": true
},
{
"id": "thumb_image_url",
"type": "image_picker",
"ratio": "1:1",
"width": 100,
"label": "t:schema.templates.page.settings.thumb_image_url.label",
"info": "t:schema.templates.page.settings.thumb_image_url.info"
},
{
"id": "title",
"type": "text",
"readonly": false,
"label": "t:schema.templates.page.settings.title.label",
"info": "t:schema.templates.page.settings.title.info"
},
{
"id": "description",
"type": "textarea",
"label": "t:schema.templates.page.settings.description.label"
},
{
"id": "content",
"type": "richtext",
"label": "t:schema.templates.page.settings.content.label",
"readonly": false,
"info": "t:schema.templates.page.settings.content.info"
}
]
}
{% endschema %}
