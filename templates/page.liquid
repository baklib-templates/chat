<div class="sm:flex">
    {% render 'sidebar' %}
    <!-- end left sidebar-menu -->

    <!-- start chat-leftsidebar -->
    <div class="min-w-[320px] max-w-[400px] glass border-r border-base-content/10 py-6 px-4 sm:px-6 h-screen overflow-auto hidden sm:block">
        <h2 class="mb-6 text-lg font-semibold text-base-content">目录导航</h2>

        <!-- 搜索框 -->
        {% form_tag 'search', class: 'w-full' %}
            <label class="flex gap-2 items-center mb-6 glass rounded-glass-sm px-3 py-2 focus-within:ring-2 focus-within:ring-primary/20 transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-base-content/50" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 10-14 0 7 7 0 0014 0z" />
                </svg>
                <input type="text" class="grow bg-transparent border-0 outline-none text-sm placeholder:text-base-content/40" placeholder="输入关键词过滤" name="{{form.keywords_field_name}}" value="{{ search.keywords | escape_once }}"
                autocomplete="off" />
            </label>
        {% endform_tag %}

        {% render 'nav_tree', nav_tree: site.nav_tree %}
    </div>
    <!-- end chat-leftsidebar -->

    <!-- Start User chat -->
    <turbo-frame id="page-content" class="overflow-hidden w-full bg-base-100" x-data="{ isDrawerOpen: false }">
        <input id="my-drawer" type="checkbox" class="drawer-toggle"  x-model="isDrawerOpen" />
        <!-- 抽屉侧边栏 -->
        <div class="z-20 drawer-side">
            <label for="my-drawer" class="drawer-overlay bg-black/20 backdrop-blur-sm"></label>
            <div class="overflow-auto p-4 w-80 h-screen menu glass text-base-content">
            <!-- 点击任何链接都会关闭抽屉（因为 checkbox 被取消选中） -->

            {% render 'nav_tree', nav_tree: site.nav_tree %}
            </div>
        </div>
        <div class="sm:flex">
            <div class="flex flex-col flex-1 min-h-screen">
                <!-- 欢迎语 -->
                <div class="flex overflow-x-auto justify-between items-center px-4 sm:px-8 h-16 sm:h-20 glass border-b border-base-content/10">
                    <label for="my-drawer" class="flex-none btn btn-square btn-ghost sm:hidden glass rounded-glass-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </label>

                    <h5 class="mb-0 text-sm sm:text-base text-truncate text-base-content"> 
                        {% render 'breadcrumb', breadcrumb: page.breadcrumb %}
                    </h5>
                    <!-- 右侧更多操作 -->
                    <div class="flex space-x-2">
                        <a  data-turbo-stream="true"
                        href="{{ page.feedback_path }}" class="flex items-center space-x-1 rounded-full p-2 bg-primary/20 glass hover:shadow-glass text-base-content/60 hover:text-primary transition-all duration-200 tooltip tooltip-left" data-tip="提交反馈">
                            {% if page.visitor_posted_feedback %}
                                <svg t="1698223767490" class="w-6 h-6 icon" viewBox="0 0 1024 1024" fill="currentColor" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="4875">
                                    <path d="M1000.59 407.182c-26.679-43.859-67.358-67.449-120.938-70.119-3.23-0.38-6.32-0.57-9.32-0.57l-172.356-0.59c7.819-34.839 11.979-70.079 11.979-102.798 0-33.489-3.66-67.259-10.89-100.388a41.025 41.025 0 0 0-2.36-7.35c-18.68-68.139-79.099-115.118-149.337-115.118-83.269 0-146.058 68.279-146.058 158.817l-0.061 2.28c-0.08 2.39-0.17 5.46 0.01 9.02-3.569 94.348-81.148 176.707-177.807 188.767l-136.178 2.19c-2.24-0.2-4.48-0.3-6.72-0.3-44.209 0-80.178 36.369-80.178 81.039l-0.37 481.182c0 44.369 35.989 80.479 80.229 80.479l149.368 0.03h0.08l567.93-0.98h0.011c31.429 0 51.139-8.8 74.589-24.02a158.319 158.319 0 0 0 54.589-60.578c4.33-6.98 7.55-14.44 9.59-22.22 0.13-0.511 0.26-1.021 0.37-1.521l84.648-381.714a81.977 81.977 0 0 0 2.33-22.699c1.82-32.89-6.16-64.939-23.15-92.839zM82.305 453.161c1.24 0.1 2.49 0.14 3.73 0.12l98.918-1.6v480.142l-103.028-0.02 0.38-478.642z m859.257 51.259l-84.419 380.673h-0.02a39.79 39.79 0 0 0-2.71 4.7c-6.15 12.5-15.2 22.699-26.84 30.27-14.989 9.729-19.319 10.79-30.369 10.79h-0.011l-530.321 0.915V444.231c122.238-30.1 212.877-137.708 216.337-263.466 0.05-1.68 0.03-2.8-0.13-4.48-0.021-0.78 0.02-1.56 0.05-2.35 0.05-1.61 0.09-3.23 0.09-4.87 0-38.22 22.04-76.899 64.149-76.899 34.129 0 63.408 24.02 71.208 58.399 0.44 1.92 1.011 3.78 1.7 5.57 5.15 25.48 7.76 51.339 7.76 76.969 0 40.479-8.31 87.989-22.789 130.318a40.914 40.914 0 0 0 5.39 37.02 40.906 40.906 0 0 0 33.22 17.2l226.506 0.81c1.36 0.19 2.72 0.31 4.09 0.37 26.83 1.1 43.63 10.34 56.159 30.949 8.561 14.06 12.45 30.35 11.25 47.109-0.15 2.02-0.12 4.12 0.04 6.14-0.121 0.47-0.241 0.93-0.34 1.4z" fill="currentColor" p-id="4876"></path>
                                </svg>
                            {% else %}
                                <svg t="1698223767490" class="w-6 h-6 icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="4875">
                                    <path d="M1000.59 407.182c-26.679-43.859-67.358-67.449-120.938-70.119-3.23-0.38-6.32-0.57-9.32-0.57l-172.356-0.59c7.819-34.839 11.979-70.079 11.979-102.798 0-33.489-3.66-67.259-10.89-100.388a41.025 41.025 0 0 0-2.36-7.35c-18.68-68.139-79.099-115.118-149.337-115.118-83.269 0-146.058 68.279-146.058 158.817l-0.061 2.28c-0.08 2.39-0.17 5.46 0.01 9.02-3.569 94.348-81.148 176.707-177.807 188.767l-136.178 2.19c-2.24-0.2-4.48-0.3-6.72-0.3-44.209 0-80.178 36.369-80.178 81.039l-0.37 481.182c0 44.369 35.989 80.479 80.229 80.479l149.368 0.03h0.08l567.93-0.98h0.011c31.429 0 51.139-8.8 74.589-24.02a158.319 158.319 0 0 0 54.589-60.578c4.33-6.98 7.55-14.44 9.59-22.22 0.13-0.511 0.26-1.021 0.37-1.521l84.648-381.714a81.977 81.977 0 0 0 2.33-22.699c1.82-32.89-6.16-64.939-23.15-92.839zM82.305 453.161c1.24 0.1 2.49 0.14 3.73 0.12l98.918-1.6v480.142l-103.028-0.02 0.38-478.642z m859.257 51.259l-84.419 380.673h-0.02a39.79 39.79 0 0 0-2.71 4.7c-6.15 12.5-15.2 22.699-26.84 30.27-14.989 9.729-19.319 10.79-30.369 10.79h-0.011l-530.321 0.915V444.231c122.238-30.1 212.877-137.708 216.337-263.466 0.05-1.68 0.03-2.8-0.13-4.48-0.021-0.78 0.02-1.56 0.05-2.35 0.05-1.61 0.09-3.23 0.09-4.87 0-38.22 22.04-76.899 64.149-76.899 34.129 0 63.408 24.02 71.208 58.399 0.44 1.92 1.011 3.78 1.7 5.57 5.15 25.48 7.76 51.339 7.76 76.969 0 40.479-8.31 87.989-22.789 130.318a40.914 40.914 0 0 0 5.39 37.02 40.906 40.906 0 0 0 33.22 17.2l226.506 0.81c1.36 0.19 2.72 0.31 4.09 0.37 26.83 1.1 43.63 10.34 56.159 30.949 8.561 14.06 12.45 30.35 11.25 47.109-0.15 2.02-0.12 4.12 0.04 6.14-0.121 0.47-0.241 0.93-0.34 1.4z" fill="currentColor" p-id="4876"></path>
                                </svg>
                            {% endif %}
                        </a>
                    </div>
                </div>

                <div class="h-[calc(100vh-120px)] overflow-y-auto p-4 sm:p-6 md:px-12 relative first-letter:text">
                    {% if site.settings.show_author or site.settings.show_published_at %}
                    <section class="mt-2 mb-6">
                        {% if site.settings.show_author and site.settings.show_published_at %}
                        <div class="flex items-center space-y-2">
                            <div class="flex items-center space-x-2">
                                {% render 'avatar', url: page.author.avatar_url, name: page.author.name %}
                                <div class="flex flex-col space-y-0.5">
                                    <span class="text-xs">{{ page.author.name }}</span>
                                    <span class="text-xs text-base-content/60">{{ 'generic.published_at' | t }}: {{
                                        page.published_at | date: "%Y-%m-%d" }}</span>
                                </div>
                            </div>
                        </div>
                        {% elsif site.settings.show_author %}
                        {% render 'avatar_with_name', url: page.author.avatar_url, name: page.author.name %}
                        {% elsif site.settings.show_published_at %}
                        <p class="text-sm text-base-content/50 text-md">{{ 'generic.published_at' | t }}: {{
                            page.published_at | date: "%Y-%m-%d" }}</p>
                        {% endif %}
                    </section>
                    {% endif %}

                    {% # 标题 %}
                    {% assign title = page.settings.title | presence %}
                    {% if title %}
                    <header class="py-2 pl-4 mb-6 border-l-4 border-primary">
                        <h1 class="text-2xl sm:text-3xl md:text-4xl font-semibold text-base-content leading-tight">
                            {{ title }}
                        </h1>
                    </header>
                    {% endif %}

                    {% # 标签 %}
                    {% if page.settings.tags and page.settings.tags.size > 0 %}
                    <section class="flex flex-wrap gap-2 items-center mb-6">
                        {% for tag in page.settings.tags %}
                        {% render 'tag', tag: tag %}
                        {% endfor %}
                    </section>
                    {% endif %}

                    {% # 摘要 %}
                    {% assign description = page.settings.description | presence %}
                    {% if description %}
                    <section class="mb-6">
                        <blockquote class="p-4 sm:p-6 italic rounded-glass glass text-base-content/70 text-sm sm:text-base">
                            <p>{{ description }}</p>
                        </blockquote>
                    </section>
                    {% endif %}

                    <article class="ProseMirror prose sm:prose-base lg:prose-lg">
                        {{ page.settings.content }}
                        <p></p>
                    </article>
                </div>
                <div class="hidden sm:block">
                    {%# render 'footer', page: page %}
                </div>
            </div>
        </div>
        <!-- End User chat -->
    </turbo-frame>
    <!-- end  layout wrapper -->
</div>

{% schema %}
{
"name": "t:schema.templates.page.name",
"description": "t:schema.templates.page.description",
"thumb_url": "images/theme/page.png",
"sub_page_templates": ["page"],
"settings": [
{
    "id": "title",
    "type": "text",
    "readonly": true,
    "label": "t:schema.templates.page.settings.title.label",
    "info": "t:schema.templates.page.settings.title.info"
},
{
    "id": "tags",
    "type": "tag_picker",
    "multiple": true,
    "label": "t:schema.templates.page.settings.tags.label",
    "query_enabled": true
},
{
    "id": "content",
    "type": "richtext",
    "label": "t:schema.templates.page.settings.content.label",
    "readonly": true,
    "info": "t:schema.templates.page.settings.content.info"
}
]
}
{% endschema %}
