{% assign logo_url = site.settings.logo_url | presence %}
<div class="sm:flex">
    {% render 'sidebar' %}

    <!-- start chat-leftsidebar -->
    <div class=" min-w-[320px] max-w-[400px]  bg-base-200 border-r border-base-300 px-8 py-8 hidden sm:block">

        <div class="mb-6">
            <div class="flex justify-center items-center p-6 rounded-lg shadow-sm bg-base-100">
                {% if logo_url %}
                <img src="{{ logo_url }}" alt="{{ site.name | escape_once }}" class="mr-4 w-12 h-12">
                {% else %}
                {% assign favicon_url = site.favicon_url | presence %}
                {% if favicon_url %}
                <img src="{{ favicon_url }}" alt="{{ site.name | escape_once }}" class="mr-4 w-12 h-12">
                {% endif %}
                {% endif %}
                <span class="text-4xl font-bold text-base-content/80"> {{ site.settings.brand_name }} </span>
            </div>
        </div>

        <!-- 网站名称和公司 -->
        <div class="mb-6">
            <div class="text-center">
                <div class="mb-1 text-xl font-bold">{{ site.name }}</div>
                <div class="flex justify-center items-center text-base text-base-content/50">
                    <span class="inline-block mr-2 w-2 h-2 bg-green-400 rounded-full"></span>
                    {{ site.settings.company_name }}
                </div>
            </div>
        </div>

        <!-- 简介 -->
        <div class="mb-6">
            <p class="leading-relaxed text-base-content/50 indent-8">
                {{ site.settings.site_description }}
            </p>
        </div>

        <div class="w-full max-w-md shadow-md bg-base-100 rounded-box">
        <div class="bg-base-100 collapse collapse-arrow">
            <input type="checkbox" class="peer" checked/>
            <div class="flex gap-2 items-center text-base font-semibold text-base-content/90 collapse-title">
                快捷导航
            </div>
            <div class="leading-6 text-base-content/80 collapse-content">
            <ul class="pl-2 space-y-1 list-disc list-inside">
                <li><a href="/" class="hover:underline">返回官网</a></li>
                <li><a href="/developers" class="hover:underline">开发者中心</a></li>
                <li><a href="/releases" class="hover:underline">产品发布</a></li>
            </ul>
            </div>
        </div>
        </div>
    </div>
    <!-- end chat-leftsidebar -->

    <!-- Start User chat -->
    <div class="overflow-hidden w-full bg-base-100">
        <div class="sm:flex">
            <div class="flex flex-col flex-1 min-h-screen">
                <!-- 欢迎语 -->
                <div class="flex justify-between items-center px-8 h-20 border-b bg-base-100 border-base-content/15">
                    <!-- 左侧绿色小圆点 -->
                    <span><i class="ri-record-circle-fill font-size-10 text-success d-inline-block ms-1"></i></span>
                    <!-- 右侧更多操作 -->
                </div>
                <div class="px-4 py-16 my-12 mb-36 text-center text">
                    <div class="mb-2 text-5xl font-bold align-middle">
                        {{ site.settings.welcome_title }}
                    </div>
                    <div class="mx-auto mt-4 mb-8 max-w-xl text-lg font-normal text-left text-base-content/50 indent-8">
                       {{ site.settings.welcome_description }}
                    </div>
                    <!-- 输入框 -->
                    {% form_tag 'search', class: 'w-full' %}
                    <div class="flex justify-center items-center mb-6">
                        <div class="relative w-full max-w-md">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-base-content/60">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2"
                                    viewBox="0 0 24 24">
                                    <circle cx="11" cy="11" r="8" />
                                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                                </svg>
                            </span>
                            <input type="text" placeholder="输入问题"
                                class="pl-10 w-full text-base bg-base-300 input input-bordered"
                                name="{{form.keywords_field_name}}" value="{{ search.keywords | escape_once }}"
                                placeholder="{{ " layout.theme.search_input_placeholder" | t }}" autocomplete="off" />
                        </div>
                    </div>
                    <!-- 按钮 -->
                    <button class="w-40 text-base btn btn-primary">开始聊天</button>
                    {% endform_tag %}
                </div>

                <div class="p-1 border-t border-base-content/15">
                </div>
            </div>

            <div class="hidden user-profile-sidebar">
                <div class="px-3 pt-3 px-lg-4 pt-lg-4">
                    <div class="user-chat-nav text-end">
                        <button type="button" class="btn nav-btn" id="user-profile-hide">
                            <i class="ri-close-line"></i>
                        </button>
                    </div>
                </div>

                <div class="p-4 text-center border-bottom">
                    <div class="mb-4">
                        <img src="assets/images/users/avatar-4.jpg" class="rounded-circle avatar-lg img-thumbnail"
                            alt="">
                    </div>

                    <h5 class="mb-1 font-size-16 text-truncate">Doris Brown</h5>
                    <p class="mb-1 text-muted text-truncate"><i
                            class="ri-record-circle-fill font-size-10 text-success me-1 ms-0"></i> Active</p>
                </div>
                <!-- End profile user -->

                <!-- Start user-profile-desc -->

                <!-- end user-profile-desc -->
            </div>
        </div>
        <!-- End User chat -->
    </div>
    <!-- end  layout wrapper -->
</div>

{% schema %}
{
"name": "t:schema.templates.index.name",
"description": "t:schema.templates.index.description",
"thumb_url": "images/theme/${lang}/index-preview.png",
"sub_page_templates": [
"page"
]
}
{% endschema %}
