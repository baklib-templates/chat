{%- comment -%}
  空状态组件
  参数：
  - title: 标题文本
  - description: 描述文本
  - icon: 图标名称（可选）

  使用方法：
  {% render 'empty',
      title: '没有找到相关内容',
      description: '请尝试其他搜索关键词或浏览其他分类',
      icon: 'video',
      button_text: '返回首页',
      button_url: '/'
  %}
{%- endcomment -%}

{% assign default_title = 'snippets.empty.title' | t %}
{% assign default_description = 'snippets.empty.description' | t %}
{% assign default_button_text = 'snippets.empty.button_text' | t %}

<div class="px-4 py-16 mx-auto">
  <div class="flex flex-col justify-center items-center text-center">
    {%- if icon -%}
      <div class="mb-6 text-base-content/60">
        <svg class="mx-auto w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          {%- case icon -%}
            {%- when 'search' -%}
              <i class="text-7xl ri-search-2-line"></i>
            {%- when 'document' -%}
              <i class="text-7xl ri-article-line"></i>
            {%- when 'video' -%}
              <i class="text-7xl ri-movie-2-line"></i>
            {%- else -%}
              <i class="text-7xl ri-information-line"></i>
          {%- endcase -%}
        </svg>
      </div>
    {%- endif -%}

    <h2 class="mb-3 text-2xl font-semibold text-base-content">
      {{ title | default: default_title }}
    </h2>

    {%- if description -%}
      <p class="mx-auto max-w-md text-base-content/50">
        {{ description | default: default_description }}
      </p>
    {%- endif -%}

    {%- if button_text and button_url -%}
      <div class="mt-8">
        <a href="{{ button_url | default: '/' }}" class="rounded-full btn btn-primary">
          {{ button_text | default: default_button_text }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>
