<aside class="w-[var(--left-sidebar-width)] max-w-80 shrink-0 flex-col border-r border-base-content/5 bg-base-100 p-5 backdrop-blur-xl flex bg-base-100 h-full ">
  <div class="mb-7 flex items-center gap-3">
    <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center">
      {% assign favicon_url = site.favicon_url | presence %}
      {% if favicon_url %}
        <img src="{{ favicon_url }}" alt="" class="h-10 w-10 object-contain" />
      {% else %}
        <div class="rounded-lg bg-primary text-primary-content shadow-md shadow-primary/20 h-10 w-10 flex items-center justify-center">
          <i class="ri-sparkling-2-fill text-xl" aria-hidden="true"></i>
        </div>
      {% endif %}
    </div>
    <div class="min-w-0">
      <p class="truncate text-base font-bold text-base-content">{{ site.name | escape_once }}</p>
      <p class="text-sm font-semibold tracking-wider text-base-content/45">Knowledge AI</p>
    </div>
  </div>

  <a href="/" class="mb-5 flex w-full items-center justify-center gap-2 rounded-xl border border-base-content/10 px-4 py-3 text-sm font-bold text-base-content transition-all hover:border-primary/25 hover:bg-primary/10 hover:text-primary">
    <i class="ri-add-line text-lg" aria-hidden="true"></i>
    <span>新建会话</span>
  </a>

  {%- assign current_path = page.path -%}
  {%- assign current_chat_id = params.id | default: params.chat_id | strip -%}
  {%- assign chat_page_url = statics['chat'] -%}
  {%- assign recent_chats = site.ai_chats | limit: 20 -%}
  {%- assign is_home = false -%}
  {%- if current_path == "/" -%}
    {%- assign is_home = true -%}
  {%- endif -%}
  {%- assign kb_item = site.pages['/'].children_in_list | first -%}
  {%- assign nav_link = 'flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium text-base-content/65 transition-all hover:bg-base-content/5 hover:text-base-content' -%}
  {%- assign nav_active = 'bg-primary/10 font-semibold text-primary' -%}
  {%- assign nav_icon = 'flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-base-content/5 text-base' -%}
  {%- assign nav_icon_active = 'bg-primary text-primary-content' -%}

  <nav class="flex flex-1 flex-col gap-1 overflow-y-auto" data-controller="nav-tree" data-nav-tree-active-class="{{ nav_active }}">
    <p class="mb-2 px-2 text-xs font-semibold tracking-wider text-base-content sticky top-0 bg-base-100">菜单</p>
    <a href="{{ kb_item.path }}" class="{{ nav_link }}{% if current_path == kb_item.path %} {{ nav_active }}{% endif %}" data-nav-tree-target="item">
      <i class="{{ nav_icon }}{% if current_path == kb_item.path %} {{ nav_icon_active }}{% endif %} ri-book-2-line" aria-hidden="true"></i>
      <span>知识库</span>
    </a>

    {% if recent_chats %}
      <div class="mt-4 pt-3">
        <details open class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between px-2 py-1.5 text-xs font-semibold text-base-content [&::-webkit-details-marker]:hidden sticky top-0 bg-base-100">
            <span>最近</span>
            <i class="ri-arrow-down-s-line text-base text-base-content/40 transition-transform group-open:rotate-180" aria-hidden="true"></i>
          </summary>
          <ul class="mt-1 flex flex-col space-y-1">
            {% for chat in recent_chats %}
              {% assign chat_title = chat.title | default: '新对话' %}
              <li>
                <a
                  href="{{ chat_page_url }}?id={{ chat.id }}"
                  class="block truncate rounded-lg px-2 py-2 text-sm text-base-content/80 transition-colors hover:bg-base-content/5 hover:text-base-content{% if current_chat_id == chat.id %} bg-base-content/5 font-medium text-base-content{% endif %}"
                  data-turbo-frame="_top"
                  title="{{ chat_title | escape_once }}"
                >{{ chat_title | escape_once }}{{ chat.id }}</a>
              </li>
            {% endfor %}
          </ul>
        </details>
      </div>
    {% endif %}
  </nav>

  {% render 'left_sidebar_footer' %}
</aside>
